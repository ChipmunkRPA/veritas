#!/bin/bash
# Executed only by the future GCE VM. Never run this on a development host.
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive
# A failed refresh must not start the previous/partially written release. /run is host tmpfs.
install -d -m 0700 /run/veritas
rm -f /run/veritas/provisioned
if systemctl cat veritas.service >/dev/null 2>&1; then
  systemctl stop veritas.service
fi
apt-get update
apt-get install -y --no-install-recommends docker.io docker-compose-v2 python3 ca-certificates curl gnupg
systemctl enable --now docker
install -d -m 0755 /opt/veritas
printf '%s' '${config}' | base64 --decode > /opt/veritas/config.json
%{ for name, encoded in assets ~}
printf '%s' '${encoded}' | base64 --decode > /opt/veritas/${name}
%{ endfor ~}
chmod 0644 /opt/veritas/*.py /opt/veritas/config.json
for disk in data models; do
  device=/dev/disk/by-id/google-veritas-$disk
  for attempt in $(seq 1 60); do
    test -b "$device" && break
    sleep 2
  done
  test -b "$device"
  filesystem=$(blkid -s TYPE -o value "$device" || true)
  if [ -z "$filesystem" ]; then
    # Refuse disks with unknown signatures instead of erasing them.
    test -z "$(wipefs --no-act --noheadings --output TYPE "$device")"
    mkfs.ext4 -m 0 "$device"
  elif [ "$filesystem" != ext4 ]; then
    echo "Refusing unexpected filesystem on $device" >&2
    exit 1
  fi
  target=/srv/veritas/$disk
  install -d -m 0750 "$target"
  uuid=$(blkid -s UUID -o value "$device")
  if ! grep -q "^UUID=$uuid " /etc/fstab; then
    printf 'UUID=%s %s ext4 defaults,nodev,nosuid 0 2\n' "$uuid" "$target" >> /etc/fstab
  fi
  mountpoint -q "$target" || mount "$target"
  test "$(findmnt -n -o UUID --mountpoint "$target")" = "$uuid"
  # Do not recursively chmod originals (the content-addressed store is write-once).
  chown 10001:10001 "$target"
done
install -d -o 10001 -g 10001 -m 0700 /srv/veritas/data/tmp
if python3 -c 'import json; raise SystemExit(not json.load(open("/opt/veritas/config.json"))["gpu_enabled"])'; then
  # Use a reviewed image with the driver installed; no silent CPU fallback.
  nvidia-smi
  curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor --yes -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
  curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' > /etc/apt/sources.list.d/nvidia-container-toolkit.list
  apt-get update
  apt-get install -y --no-install-recommends nvidia-container-toolkit
  nvidia-ctk runtime configure --runtime=docker
  systemctl restart docker
fi
cat > /etc/systemd/system/veritas.service <<'UNIT'
[Unit]
Description=Veritas private API and single worker
BindsTo=docker.service
PartOf=docker.service
After=docker.service network-online.target google-startup-scripts.service
Wants=network-online.target
RequiresMountsFor=/srv/veritas/data /srv/veritas/models
[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart=/usr/bin/python3 /opt/veritas/runtime.py start
ExecStop=/usr/bin/python3 /opt/veritas/runtime.py stop
ExecStopPost=/usr/bin/python3 /opt/veritas/runtime.py stop
TimeoutStartSec=3600
TimeoutStopSec=360
[Install]
WantedBy=multi-user.target docker.service
UNIT
systemctl daemon-reload
systemctl enable veritas.service
# A disabled runtime never reads secrets or pulls images. It is ready for controlled provisioning.
python3 /opt/veritas/runtime.py stop
touch /run/veritas/provisioned
# Do not wait on ourselves: Veritas is ordered after the GCE metadata startup unit.
systemctl --no-block restart veritas.service
