{% if v.get('evidence') and not v.evidence.available %}<p class="caption evidence-unavailable">{{ v.evidence.note }}</p>{% endif %}
{% if v.get('evidence') and v.evidence.available %}
{% set evidence = v.evidence %}
{% macro plates(images, wide=false) %}
{% if images and not evidence.withheld %}
<div class="multimedia-plates{% if wide %} multimedia-wide{% endif %}">
{% for image in images %}<figure{% if image.get('anchor') %} id="{{ image.anchor }}"{% endif %}><img src="{{ image.uri }}" alt="{{ image.label }}"><figcaption>{{ image.label }}</figcaption></figure>{% endfor %}
</div>
{% endif %}
{% endmacro %}
<section class="{% if evidence.packets or evidence.overview or evidence.acoustic_contexts or evidence.get('repetition_context') or evidence.get('similarity_context') or evidence.get('repeated_passages') %}chapter{% else %}chapter-cont{% endif %} multimedia-evidence{% if s.report.profile in ['summary', 'newsroom'] and evidence.packets %} evidence-appendix{% endif %}" aria-labelledby="multimedia-evidence-heading">
<h2 class="chapter-title" id="multimedia-evidence-heading">{% if v.get('number', {}).get('source-evidence') %}<span class="n">{{ v.number['source-evidence'] }}</span>{% endif %}{{ evidence.title }}</h2>
<p>{{ evidence.note }}</p>
{% if evidence.available %}
<p class="caption">Evidence set {{ evidence.version }} - SHA-256 <span class="mono evidence-hash">{{ evidence.sha256 }}</span></p>
<p class="caption"{% if evidence.kind == 'audio' %} id="multimedia-evidence-voice-coverage"{% endif %}>{{ evidence.coverage_note }}</p>
{% for note in evidence.coverage_details %}<p class="caption">{{ note }}</p>{% endfor %}
{% if evidence.get('short_voice_review') %}
{% set review = evidence.short_voice_review %}
<h3 id="multimedia-short-voice-review">{{ review.title }}</h3>
<p class="caption">{% if review.status == 'skipped' %}Skipped. {% endif %}{{ review.reason }}</p>
{% if review.status == 'flagged' %}
<p class="caption">Flagged window {{ '%.3f' | format(review.start_s) }}–{{ '%.3f' | format(review.end_s) }} s.
Samples [{{ review.interval.start_sample }}, {{ review.interval.end_sample }}) at 16000 Hz.
{% for range in review.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if review.get('waveform') %}{{ plates([review.waveform]) }}{% endif %}
{% endif %}
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/short_voice_review</span>.</p>
{% endif %}
{% if evidence.get('long_voice_review') %}
{% set review = evidence.long_voice_review %}
<h3 id="multimedia-long-voice-review">{{ review.title }}</h3>
<p class="caption">{% if review.status == 'skipped' %}Skipped. {% endif %}{{ review.reason }}</p>
{% for window in review.windows %}
<p class="caption"><strong>{{ window.label }}</strong>. {{ '%.3f' | format(window.start_sample / 16000) }}–{{ '%.3f' | format(window.end_sample / 16000) }} s.
Samples [{{ window.start_sample }}, {{ window.end_sample }}) at 16000 Hz.
{% for range in window.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if window.get('waveform') %}{{ plates([window.waveform]) }}{% endif %}
{% endfor %}
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/long_voice_review</span>.</p>
{% endif %}
{% if evidence.get('background_reduced_voice_review') %}
{% set review = evidence.background_reduced_voice_review %}
<h3 id="multimedia-background-reduced-voice-review">{{ review.title }}</h3>
<p class="caption">{{ review.reason }}</p>
{% if review.status == 'flagged' %}
<p class="caption">Flagged interval 0.000–3.000 s. Samples [{{ review.interval.start_sample }}, {{ review.interval.end_sample }}) at 16000 Hz.
{% for range in review.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if not evidence.withheld %}<p class="caption">The evidence export includes original and background-reduced playback of this interval.</p>{% endif %}
{% if review.get('waveform') %}{{ plates([review.waveform]) }}{% endif %}
{% endif %}
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/background_reduced_voice_review</span>.</p>
{% endif %}
{% if evidence.get('passage_coverage') %}
{% set writing = evidence.passage_coverage %}
<h3>Recorded passage coverage</h3>
<p class="caption">Counts describe the {{ writing.mapped_characters }} extracted characters excluding whitespace. A local response applies to its input window. Context-only text was read as part of another response.</p>
<p class="caption">{% for label, amount in writing.counts %}{{ label }}: {{ amount }}. {% endfor %}</p>
{% if writing.ranges %}
<table class="multimedia-locator"><thead><tr><th>Source</th><th>Extracted character range</th><th>Local coverage</th></tr></thead><tbody>
{% for row in writing.ranges %}
<tr><td>{% if row.get('page') %}Page {{ row.page }}{% elif row.get('paragraph') %}Paragraph {{ row.paragraph }}{% else %}Source block {{ row.source_block }}{% endif %}{% if row.get('mime_part') %} · Email part {{ row.mime_part }}{% endif %}{% if row.get('quote_role') %} · {{ row.quote_role }}{% endif %}</td><td>[{{ row.start }}, {{ row.end }})</td><td>{{ row.label }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}
<p class="caption">Ranges use extracted Unicode characters and exclude the end position. {% if writing.additional_ranges %}{{ writing.additional_ranges }} more retained ranges appear in the JSON report. {% endif %}{% if writing.omitted_ranges %}The counts include {{ writing.omitted_ranges }} additional ranges beyond the retained list. {% endif %}JSON pointer <span class="mono">/coverage/local_passage_coverage</span>.</p>
{% if writing.pdf_pages %}
{% set page_coverage = writing.pdf_pages %}
<h3>Text coverage by PDF page</h3>
<p class="caption">The source contains {{ page_coverage.page_count }} {% if page_coverage.page_count == 1 %}page{% else %}pages{% endif %}. Counts exclude whitespace and cover mapped text. Unmapped text and unchecked image areas have no local result.</p>
<table class="multimedia-locator"><thead><tr><th>PDF page</th><th>Extraction</th><th>Local response</th><th>Context only</th><th>No local record</th></tr></thead><tbody>
{% for row in page_coverage.rows %}
<tr><td>{% if row.start == row.end %}Page {{ row.start }}{% else %}Pages {{ row.start }}–{{ row.end }}{% endif %}</td>
<td>{{ row.label }}{% if row.get('partial') %}. Unchecked image areas{% endif %}</td>
{% if row.counts %}<td>{{ row.counts.response_range }}</td><td>{{ row.counts.context_only }}</td><td>{{ row.counts.no_local_record }}</td>
{% else %}<td>—</td><td>—</td><td>—</td>{% endif %}</tr>
{% endfor %}
</tbody></table>
<p class="caption">{% if page_coverage.additional_rows %}{{ page_coverage.additional_rows }} more rows appear in the JSON report. {% endif %}JSON pointer <span class="mono">/coverage/local_passage_coverage/pdf_pages</span>.</p>
{% endif %}
{% endif %}
{% if evidence.get('writing_agreement') %}
<h3>Second writing check</h3>
<p class="caption">The second check revisits the exact text behind up to six AI-like responses. This evidence carries zero weight in the overall assessment.</p>
{% if evidence.writing_agreement.email_reply_body %}<p class="caption">This check covers contexts wholly inside the reply body. Text marked as a quote or signature and contexts that cross those boundaries are outside this check.</p>{% endif %}
{% if evidence.writing_agreement.mapped_html_body %}<p class="caption">The JSON includes exact positions in the decoded HTML body of the selected email part.</p>{% endif %}
{% if evidence.writing_agreement.ranges %}
<table class="multimedia-locator"><thead><tr><th>Passage focus</th><th>First-check context</th><th>Second check</th></tr></thead><tbody>
{% for row in evidence.writing_agreement.ranges %}
<tr><td>[{{ row.start }}, {{ row.end }})</td><td>{% for span in row.spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %}</td><td>{{ row.label }}</td></tr>
{% endfor %}
</tbody></table>
<p class="caption">Ranges use extracted Unicode characters. JSON pointer <span class="mono">/coverage/writing_second_check</span>.</p>
{% else %}<p class="caption">The first check supplied no AI-like contexts for this review.</p>{% endif %}
{% endif %}
{% if evidence.get('audio_tracks') %}
<div class="multimedia-acoustic-summary">
<h3>Audio track coverage</h3>
{% set count = evidence.audio_tracks | length %}
<p>The file contains {{ count }} audio tracks. Audio checks used the first track (source stream index {{ evidence.audio_tracks[0] }}). {% if count == 2 %}The second track was unassessed.{% else %}The other {{ count - 1 }} tracks were unassessed.{% endif %}</p>
<p class="caption">The track list is recorded at JSON pointer <span class="mono">{{ evidence.audio_tracks_pointer }}</span>.</p>
</div>
{% endif %}
{% if evidence.get('audio_source_clock') %}
{% set clock = evidence.audio_source_clock %}
{% set rate = evidence.audio_source_clock_rate %}
<h3>Audio source clock breaks</h3>
{% if clock.get('recording_voice_estimate_withheld') %}
<p>The source audio timestamps contain a gap or overlap. Voice checks use only continuous intervals, so the report gives no recording-wide voice estimate.</p>
{% endif %}
{% if clock.total_discontinuities %}
<p class="caption">The decoded listening copy joins these source spans. {{ clock.scored_windows_crossing }} recorded voice {{ 'window crosses' if clock.scored_windows_crossing == 1 else 'windows cross' }} a source clock break. This timing check carries zero weight in the AI assessment.</p>
{% for item in clock.breaks %}
<p class="caption">At {{ '%.3f' | format(item.boundary_sample / rate) }} s of analyzed audio. Source timestamp {{ 'gap' if item.jump_samples > 0 else 'overlap' }} of {{ '%.3f' | format((item.jump_samples | abs) * 1000 / rate) }} ms.
On the original timeline, the audio spans {{ '%.3f' | format(item.before.source_start_pts / rate) }} s to {{ '%.3f' | format(item.before.source_end_pts / rate) }} s before the break and {{ '%.3f' | format(item.after.source_start_pts / rate) }} s to {{ '%.3f' | format(item.after.source_end_pts / rate) }} s after it.
{{ item.scored_windows_crossing }} recorded voice {{ 'window crosses' if item.scored_windows_crossing == 1 else 'windows cross' }} this break.</p>
{% endfor %}
<p class="caption">This check lists jumps of at least {{ '%.0f' | format(clock.minimum_jump_samples * 1000 / rate) }} ms. {% if clock.total_discontinuities > clock.breaks | length %}Showing the {{ clock.breaks | length }} largest of {{ clock.total_discontinuities }} breaks. The full source timeline is in JSON.{% endif %}</p>
{% else %}
<p class="caption">No source clock break of at least {{ '%.0f' | format(clock.minimum_jump_samples * 1000 / rate) }} ms was measured in {{ '%.3f' | format(clock.checked_samples / rate) }} s of decoded audio. This timing check carries zero weight in the AI assessment.</p>
{% endif %}
<p class="caption">JSON pointer <span class="mono">{{ evidence.audio_source_clock_pointer }}</span>.</p>
{% endif %}
{% if evidence.get('voice_gaps') %}
<h3>Unscored voice intervals</h3>
<p class="caption">These times have no recorded voice response. Background sound can affect coverage, and the gap alone does not establish its cause.</p>
{% for gap in evidence.voice_gaps %}
<p class="caption">Analyzed audio {{ '%.3f' | format(gap.start_s) }}–{{ '%.3f' | format(gap.end_s) }} s.
{% for range in gap.ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% if range.playback %} Video playback {{ '%.3f' | format(range.playback[0]) }}–{{ '%.3f' | format(range.playback[1]) }} s.{% endif %}{% endfor %}
{% if gap.omitted_ranges %} {{ gap.omitted_ranges }} additional source-clock ranges in JSON.{% endif %}</p>
{% endfor %}
<p class="caption">JSON pointer <span class="mono">{{ evidence.voice_gap_pointer }}</span>.{% if evidence.voice_gap_count > evidence.voice_gaps | length %} {{ evidence.voice_gap_count - (evidence.voice_gaps | length) }} additional intervals in JSON.{% endif %}</p>
{% endif %}
{% if evidence.get('voice_stereo_overlaps') %}
<h3>Unscored voice during a mono level drop</h3>
<p class="caption">The <a href="#multimedia-stereo-context">stereo measurements</a> and unscored voice times overlap below. The cause of the missing voice score is unknown.</p>
{% for overlap in evidence.voice_stereo_overlaps %}
<p class="caption">Overlap {{ '%.3f' | format(overlap.start_s) }}–{{ '%.3f' | format(overlap.end_s) }} s of analyzed audio.
{% if overlap.attenuation_db is none %}Mono was digitally silent in the overlapping stereo measurement.{% else %}The overlapping one-second stereo measurement found mono {{ overlap.attenuation_db }} dB quieter than the louder channel.{% endif %}
{% for range in overlap.ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% if range.playback %} Video playback {{ '%.3f' | format(range.playback[0]) }}–{{ '%.3f' | format(range.playback[1]) }} s.{% endif %}{% endfor %}
{% if overlap.omitted_ranges %} {{ overlap.omitted_ranges }} additional source-clock ranges in JSON.{% endif %}</p>
{% endfor %}
<p class="caption">JSON pointer <span class="mono">{{ evidence.voice_stereo_overlap_pointer }}</span>.{% if evidence.voice_stereo_overlap_count > evidence.voice_stereo_overlaps | length %} {{ evidence.voice_stereo_overlap_count - (evidence.voice_stereo_overlaps | length) }} additional overlaps in JSON.{% endif %}</p>
{% endif %}
{% if evidence.withheld %}<p class="caption evidence-withheld">Source media, page images and verbatim excerpts are withheld in this redacted copy. Evidence hashes, measured responses and non-content anchors remain.</p>{% endif %}
{% if evidence.packets %}
<h3>Evidence locator</h3>
<p class="caption">These identifiers match the local analysis view and evidence.json. Each JSON pointer below identifies the exact packet in that file. Asset checksums identify the same PNG, WAV or MP4 files in the evidence ZIP.</p>
<table class="multimedia-locator"><thead><tr><th>Evidence</th><th>Source location</th><th>JSON pointer</th></tr></thead><tbody>
{% for packet in evidence.packets %}<tr><td><a href="#multimedia-evidence-{{ packet.id }}">{{ packet.id }}</a></td><td>{{ packet.locator }}</td><td class="mono">{{ packet.json_pointer }}</td></tr>{% endfor %}
</tbody></table>
{% endif %}
{{ plates(evidence.overview, true) }}
{% if evidence.get('stereo_context') %}
{% include "sections/stereo_context.html.j2" %}
{% endif %}
{% include "sections/repetition_context.html.j2" %}
{% for context in evidence.acoustic_contexts %}
<div class="multimedia-acoustic-summary">
<h3>Background and acoustic context</h3>
<p>{{ context.method.description }}</p>
<p class="caption">{{ context.bin_count }} measured time bins; {{ context.event_count }} selected acoustic events. JSON pointer <span class="mono">{{ context.json_pointer }}</span>. These measurements describe the mixed recording; they do not isolate background sounds from speech or determine AI authorship.</p>
{% if context.source.sample_rate %}<p class="caption">Source PCM: {{ context.source.samples }} samples at {{ context.source.sample_rate }} Hz. SHA-256 <span class="mono evidence-hash">{{ context.source.pcm_sha256 }}</span>.</p>{% endif %}
{{ plates(context.images, true) }}
{% for note in context.limitations %}<p class="caption">{{ note }}</p>{% endfor %}
</div>
{% endfor %}
{% for packet in evidence.packets %}
<article class="multimedia-evidence-packet" id="multimedia-evidence-{{ packet.id }}">
<h3>{{ packet.id }} - {{ packet.title }}</h3>
{% if packet.get('customer_inference') %}<p class="finding-inference"><strong>Inference:</strong> {{ packet.customer_inference }}</p>{% endif %}
<p class="caption">JSON pointer <span class="mono">{{ packet.json_pointer }}</span> - {{ packet.locator }}.</p>
<p class="caption">{% if packet.finding_ids %}Findings {{ packet.finding_ids | join(', ') }}{% endif %}{% if packet.signal_refs %} - Checks {% for ref in packet.signal_refs %}{{ ref.display_id or 'recorded check' }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
<p><strong>Observed:</strong> {{ packet.observation }}</p>
<p><strong>Interpretation:</strong> {{ packet.interpretation }}</p>
{% if packet.kind in ['video', 'av'] %}
{% if packet.face_interval %}<p class="caption">The flagged range covers {{ packet.face_interval.samples.during | length }} scored samples. The before and after frames show the nearest scored samples on the same track.</p>{% endif %}
{% if packet.face_sequence %}<p class="caption">The measured review range spans {{ '%.3f' | format(packet.face_sequence.start_stream_s) }}-{{ '%.3f' | format(packet.face_sequence.end_stream_s) }} s on the source clock. Three consecutive source crops support each of {{ packet.face_sequence.centers.during | length }} centers in this range. Before and after groups provide comparison context. The sequence response is not an individual-frame confidence.</p>{% endif %}
{% if packet.face_return is defined %}<p class="caption">The brief face-change range spans {{ '%.3f' | format(packet.face_return.start_stream_s) }}-{{ '%.3f' | format(packet.face_return.end_stream_s) }} s on the source clock, with an exclusive end. The three source frames show the face before, during, and after the measured change. This range is for review and carries zero weight in overall AI confidence.</p>{% endif %}
{{ plates(packet.images, true) }}
{% if packet.clip and packet.clip.status == 'ready' %}<p class="caption">A silent video context clip is included in the JSON evidence assets and evidence ZIP, source frames [{{ packet.clip.start_frame_index }}, {{ packet.clip.end_frame_index_exclusive }}). It is a re-encoded viewing aid; extra context frames have no additional detection score. The PDF provides the corresponding frozen source frames and clip checksum below.</p>{% endif %}
{% if packet.clip and packet.clip.status == 'unavailable' and not packet.get('picture_hold') and not packet.get('picture_sequence') and not packet.get('whole_face_review') %}<p class="caption">Context clip unavailable: {{ packet.clip.reason }}. The exact recorded frame images remain available below.</p>{% endif %}
{% if packet.kind == 'av' %}<p class="caption">These 25 measurement ticks used the exact gray patches shown below. A source frame can repeat at multiple ticks; the three full-size frames are representatives.</p>{% elif packet.get('whole_face_review') %}<p class="caption">Planned native frame indices {{ packet.window.frame_indices | join(', ') }}. Three usable source frames are shown. The response describes the sampled positions.</p>{% elif packet.window %}<p class="caption">This window used {{ packet.window.frame_indices | length }} recorded input frames. The displayed frames are representatives; the window measurement is not a per-frame score.</p>{% endif %}
{% for frame in packet.frames %}
{% if frame.first_refined %}
<h4>Refined boundary estimate</h4>
<p class="caption">Denser samples suggest a range of <strong>{{ '%.3f' | format(packet.face_boundary.start_stream_s) }}–{{ '%.3f' | format(packet.face_boundary.end_stream_s) }} s</strong> on the source clock. The same tracked face was measured at {{ packet.face_boundary.frame_inputs | length }} denser sample positions. This estimate helps locate the change for review and carries no weight in overall AI confidence.</p>
{% endif %}
<div class="multimedia-frame">
<p class="caption"><strong>{{ frame.id }}{% if frame.interval_role %} - {{ frame.interval_role | capitalize }} {% if frame.refined %}refined range{% else %}flagged range{% endif %}{% endif %}</strong> - source frame {{ frame.anchor.frame_index }}, PTS {{ frame.anchor.pts }} at time base {{ frame.anchor.time_base }}; source time {{ '%.6f' | format(frame.anchor.stream_time_s) }} s{% if frame.anchor.playback_time_s is not none %}; playback {{ '%.6f' | format(frame.anchor.playback_time_s) }} s{% endif %}{% if frame.score is not none %}; response {{ '%.4f' | format(frame.score) }} (uncalibrated){% endif %}.</p>
{{ plates(frame.images) }}
{% if frame.context_region %}<p class="caption">{% if packet.kind == 'av' %}Measured mouth input{% else %}Detected face context{% endif %}: x {{ frame.context_region.x }}, y {{ frame.context_region.y }}, width {{ frame.context_region.w }}, height {{ frame.context_region.h }} pixels. This is not a pixel-edit mask.</p>{% endif %}
<p class="caption evidence-hash">Decoded RGB SHA-256 <span class="mono">{{ frame.anchor.decoded_rgb_sha256 }}</span></p>
</div>
{% endfor %}
{% if packet.kind == 'av' %}
<p class="caption">The selected lag is {{ packet.measurement.offset_ms }} ms; positive means audio later than the picture. All 31 lag candidates from -600 to +600 ms are retained in JSON. Peak correlation {{ '%.4f' | format(packet.measurement.peak_correlation) }} is a correspondence measure, not an AI probability.</p>
<p class="caption">Unshifted audio window: samples [{{ packet.audio.interval.start_sample }}, {{ packet.audio.interval.end_sample }}) at {{ packet.audio.sample_rate }} Hz. Full lag-search audio: samples [{{ packet.audio.context_interval.start_sample }}, {{ packet.audio.context_interval.end_sample }}). The silent MP4 is visual context; these WAV samples retain the actual audio inputs.</p>
{% for range in packet.audio.source_ranges %}<p class="caption">Source audio PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.</p>{% endfor %}
{% if not evidence.withheld %}<div class="multimedia-mouth-inputs">{% for input in packet.measured_inputs %}<figure><img src="{{ input.image.uri }}" alt="{{ input.image.label }}"><figcaption>{{ input.image.label }}<br>PTS {{ input.frame_pts }}</figcaption></figure>{% endfor %}</div>{% endif %}
<p class="caption">Gray mouth crops are the actual 32 by 24 inputs after grayscale and area resizing; they are not an edit mask. Correlation can be affected by ordinary timing offsets, occlusion, facial hair or unrelated speech.</p>
{% endif %}
{% elif packet.kind == 'sound' %}
<p class="caption">Sound-category input: samples [{{ packet.audio.interval.start_sample }}, {{ packet.audio.interval.end_sample }}) at {{ packet.audio.sample_rate }} Hz; {{ '%.3f' | format(packet.audio.start_s) }}-{{ '%.3f' | format(packet.audio.end_s) }} seconds on the analysed PCM timeline. Category scores rank possible sounds and are not AI confidence percentages.</p>
{{ plates(packet.images, true) }}
<p class="caption">The matching selected WAV clip is included in the JSON evidence assets and evidence ZIP. Each label covers this complete source window, not an exact sound onset or an edit boundary.</p>
{% elif packet.kind in ['audio', 'acoustic'] %}
<p class="caption">{% if packet.kind == 'acoustic' %}Measured acoustic interval{% else %}Scored input{% endif %}: samples [{{ packet.audio.interval.start_sample }}, {{ packet.audio.interval.end_sample }}) at {{ packet.audio.sample_rate }} Hz, {{ '%.3f' | format(packet.audio.start_s) }}-{{ '%.3f' | format(packet.audio.end_s) }} seconds on the analysed PCM timeline. Listening context: samples [{{ packet.audio.context_interval.start_sample }}, {{ packet.audio.context_interval.end_sample }}).</p>
{% for range in packet.audio.source_ranges %}<p class="caption">Source timestamps [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }} correspond to samples [{{ range.start_sample }}, {{ range.end_sample }}).{% if packet.audio.source_ranges | length > 1 %} The source timeline contains separate ranges; they must not be treated as uninterrupted playback.{% endif %}</p>{% endfor %}
{% if packet.kind == 'acoustic' %}<p class="caption">Acoustic context only; this interval is not a detected voice-replacement boundary.{% if packet.related_voice_packet_ids %} Overlapping voice-check intervals: {{ packet.related_voice_packet_ids | join(', ') }}. Their overlap is not independent confirmation.{% endif %}</p>{% endif %}
{{ plates(packet.images, true) }}
<p class="caption">The PDF is static. Selected and context WAV clips are identified by the same hashes as the JSON evidence assets; the plots provide inspection context and cannot independently establish synthesis.</p>
{% elif packet.kind == 'document' %}
{% set scope = packet.get('inspection_scope') %}
{% set matched_review = packet.get('matched_context_review') %}
{% if packet.get('paragraph_priority_note') %}<p class="caption">{{ packet.paragraph_priority_note }}</p>{% endif %}
{% if scope %}
<p class="caption">{% if scope.basis == 'ratio_reduction' %}Measured ratio range{% else %}Scored context ranges{% endif %}: {% for span in scope.spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %} in extracted Unicode code points. {% if scope.basis != 'ratio_reduction' %}{{ 'Selected review sentence' if matched_review else 'Navigation sentence' }} [{{ packet.focus_range.start }}, {{ packet.focus_range.end }}).{% endif %}</p>
{% else %}
<p class="caption">Highlighted range [{{ packet.focus_range.start }}, {{ packet.focus_range.end }}) in extracted Unicode codepoints. A context response is not a word-level authorship probability.</p>
{% endif %}
{% if not evidence.withheld %}
{% if scope %}
<div class="multimedia-source-context"><h4>{{ 'Selected sentence and scored context' if matched_review else 'Measured text in its source context' }}</h4><blockquote>{% for segment in packet.context.segments %}{% if matched_review and segment.highlight and not segment.get('review_focus') %}<span class="document-scored-neighbor">{{ segment.text }}</span>{% elif segment.highlight %}<mark>{{ segment.text }}</mark>{% else %}{{ segment.text }}{% endif %}{% endfor %}</blockquote><p class="caption">Source context [{{ packet.context.start }}, {{ packet.context.end }}). {% if matched_review %}The shaded sentence is the review location. Underlines mark its scored neighbors. The check read all three sentences together and carries zero weight in the overall assessment.{% else %}The highlight locates the measurement. It does not identify generated words.{% endif %}</p></div>
{% else %}
<div class="multimedia-source-context"><h4>Original text and surrounding context</h4><blockquote>{{ packet.context.before }}<mark>{{ packet.context.focus }}</mark>{{ packet.context.after }}</blockquote><p class="caption">Source context [{{ packet.context.start }}, {{ packet.context.end }}). Highlighting identifies the selected passage; it does not prove those words were generated.</p></div>
{% endif %}
{% if matched_review %}<p class="caption">Source is the original plain-text file. Positions above use extracted Unicode code points.</p>{% else %}
{% for anchor in packet.source_locations %}
<p class="caption">Source: {% if anchor.kind == 'pdf' %}PDF page {{ anchor.page }}{% if anchor.get('extraction') == 'ocr' %}, OCR text{% endif %}; coordinates refer to the unrotated page.{% elif anchor.kind == 'docx' %}DOCX paragraph {{ anchor.paragraph_index + 1 }}, body path {{ anchor.body_path | join(' / ') }}.{% elif anchor.kind in ['email', 'markup'] %}MIME part {{ anchor.get('mime_part', 'body') }}, role {{ anchor.get('quote_role', 'unknown') }}.{% else %}{{ anchor.kind }} text{% if anchor.get('source_start') is not none %}, source offset {{ anchor.source_start }}{% endif %}.{% endif %}</p>
{% endfor %}
{% endif %}
{{ plates(packet.images) }}
{% endif %}
{% for window in packet.windows %}
<div class="multimedia-scored-context"><h4>Actual scored input {{ loop.index }}</h4>
{% if 'matched_context_selected' in window %}
<p class="caption">Check {{ window.signal_ref.display_id or 'recorded check' }}. Uncalibrated response {{ '%.4f' | format(window.score) }}. {% if window.matched_context_selected %}This AI-like context response selected its middle sentence for review.{% elif window.get('matched_context_eligible') %}This context response did not select its middle sentence for review.{% else %}This input was outside short-passage review coverage.{% endif %} The response describes writing patterns across the full input.</p>
{% else %}
<p class="caption">Check {{ window.signal_ref.display_id or 'recorded check' }} - {% if window.score_kind == 'perplexity_ratio' %}raw writing-pattern ratio{% else %}uncalibrated response{% endif %} {{ '%.4f' | format(window.score) }}. Inspection boundary: {% if window.ai_when == 'lt' %}below{% else %}at or above{% endif %} {{ window.threshold }}. {% if window.supports_ai %}This response supports inspection at that boundary.{% else %}This response does not support the AI flag at that boundary; disagreement is retained.{% endif %} This is not a calibrated authorship probability.</p>
{% endif %}
<p class="caption">{% if window.score_kind == 'perplexity_ratio' %}Source envelope{% else %}Input ranges{% endif %} {% for span in window.spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %}{% if window.score_kind == 'perplexity_ratio' %}. The excerpt covers the actual recorded token contexts; exact token sequences and selected-token ranges are retained in JSON.{% else %}; these ranges were joined with a space.{% endif %}</p>
{% if not evidence.withheld %}<blockquote>{{ window.text }}</blockquote>{% endif %}
<p class="caption evidence-hash">{% if window.score_kind == 'perplexity_ratio' %}Source envelope{% else %}Actual input{% endif %} SHA-256 <span class="mono">{{ window.input_sha256 }}</span>{% if window.token_coverage.get('tokens') is not none %}; {{ window.token_coverage.tokens }} content token(s){% if window.token_coverage.get('token_windows') is not none %} across {{ window.token_coverage.token_windows }} input window(s){% endif %}{% if window.token_coverage.get('covered_tokens') is not none %}; {{ window.token_coverage.covered_tokens }} token(s) included in the response{% endif %}.{% endif %}</p>
{% for context in window.contexts %}<p class="caption evidence-hash">Actual token context [{{ context.source_token_range | join(', ') }}); predicted tokens in that forward pass [{{ context.scored_token_range | join(', ') }}), plus {{ context.anchor_token_count }} non-source anchor token(s). These are the forward-input and prediction ranges, not necessarily all the tokens used for this passage's ratio. Token sequence SHA-256 <span class="mono">{{ context.token_ids_sha256 }}</span>.</p>{% endfor %}
{% if window.score_kind == 'perplexity_ratio' %}<p class="caption">This passage's ratio uses {{ window.tokens_scored }} selected token(s), intersecting source characters {% for span in window.scored_spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %}.{% if window.neighbor_expansion %} The reduction includes neighbouring sentences because the focus sentence was short.{% endif %} Surrounding forward context can influence those token responses. Displayed scores are rounded; direction follows the recorded full-precision value.</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% if packet.get('context_comparison') %}
{% set comparison = packet.context_comparison %}
<div class="document-context-comparison">
<h4>How surrounding text affects this check</h4>
{% if comparison.get('isolated_paragraph') %}
{% set isolated = comparison.isolated_paragraph %}
<h5>Paragraph read on its own</h5>
<p>{% if isolated.supports_inspection %}The AI-like response persisted{% else %}The AI-like response did not persist{% endif %} when the check read the paragraph on its own. {{ isolated.note }}</p>
{% for label, input in [('Sentence in context', isolated.context), ('Paragraph alone', isolated.paragraph)] %}
<p class="caption">{{ label }}: raw response {{ '%.3f' | format(input.score) }}, source characters {% for span in input.spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
{% if not evidence.withheld %}<blockquote>{{ input.text }}</blockquote>{% endif %}
<p class="caption evidence-hash">Actual input SHA-256 <span class="mono">{{ input.input_sha256 }}</span>.</p>
{% endfor %}
{% endif %}
{% if comparison.status == 'recorded' %}
<p class="caption">{{ comparison.note }} Displayed responses are rounded; JSON retains the recorded values.</p>
{% for check in comparison.checks %}
<p><strong>{{ check.signal_ref.display_id or 'Recorded check' }}</strong>: response range {{ '%.3f' | format(check.lowest_response) }}-{{ '%.3f' | format(check.highest_response) }} across {{ check.distinct_inputs }} distinct saved inputs. Spread {{ '%.3f' | format(check.response_spread) }} on this check's response scale. No authorship confidence is assigned to this comparison.</p>
{% for input in check.inputs %}
<p class="caption">{{ 'Lowest' if loop.first else 'Highest' }} recorded response {{ '%.3f' | format(input.score) }}; source characters {% for span in input.spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>
{% if not evidence.withheld %}<blockquote>{{ input.text }}</blockquote>{% endif %}
<p class="caption evidence-hash">Actual input SHA-256 <span class="mono">{{ input.input_sha256 }}</span>.</p>
{% endfor %}
{% if check.omitted_inputs %}<p class="caption">{{ check.omitted_inputs }} other saved input(s) are not repeated here; these endpoints show the full recorded response range.</p>{% endif %}
{% endfor %}
{% else %}<p class="caption">{{ comparison.reason }} Context dependence could not be assessed.</p>{% endif %}
</div>
{% endif %}
{% if packet.measurements %}<dl class="evidence-measurements">{% for measure in packet.measurements %}<div><dt>{{ measure.label }}</dt><dd>{{ measure.value }}{% if measure.get('unit') %} {{ measure.unit }}{% endif %}</dd></div>{% endfor %}</dl>{% endif %}
{% if packet.limitations %}<p class="evidence-limits"><strong>Limits:</strong> {{ packet.limitations | join(' ') }}</p>{% endif %}
{% if packet.assets %}<details open class="multimedia-asset-list"><summary>Frozen evidence assets</summary>{% for asset in packet.assets %}<p class="caption evidence-hash">{{ asset.role | replace('_', ' ') }} ({{ asset.media_type }}) - SHA-256 <span class="mono">{{ asset.sha256 }}</span></p>{% endfor %}</details>{% endif %}
</article>
{% else %}{% if not (evidence.get('repetition_context') and evidence.repetition_context.pairs) and not (evidence.get('similarity_context') and evidence.similarity_context.pairs) and not (evidence.get('repeated_passages') and evidence.repeated_passages.groups) %}<p>No usable local candidates were recorded in this evidence set. This does not establish authenticity or human authorship.</p>{% endif %}{% endfor %}
{% if evidence.omitted %}<p class="caption">{{ evidence.omitted }} additional candidates were omitted from this bounded evidence set.</p>{% endif %}
{% for note in evidence.limitations %}<p class="caption">{{ note }}</p>{% endfor %}
{% endif %}
</section>
{% endif %}
