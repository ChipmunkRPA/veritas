# Copy to backend/.env. All keys are optional; see app/core/config.py for defaults.
# VERITAS_API_KEY=                   # if set, clients must send X-API-Key; unset in dev: single-user mode on loopback.
#                                    # Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# VERITAS_ENVIRONMENT=dev            # prod: an API key of at least 32 characters, docs off, JSON logs, offline by default
# VERITAS_SIGNING_KEY=               # prod default: the generated data/keys/signing.key, never derived from the API key
# VERITAS_OFFLINE=                   # unset: true in prod, false in dev (PL-01); true refuses every weight download
# VERITAS_FRONTEND_DIR=              # optional absolute path to a built SPA containing index.html
# VERITAS_MODELS_DIR=                # non-HF weights under <dir>/weights (default: VERITAS_DATA_DIR/weights)
VERITAS_DEVICE=auto                  # auto | cuda | mps | cpu
VERITAS_DATA_DIR=./data
# VERITAS_DATABASE_URL=postgresql+psycopg://user:pass@host/veritas
# Hosted Stripe Checkout: one analysis costs USD 9.99. See docs/local-stripe-billing.md.
# VERITAS_BILLING_MODE=disabled       # disabled | test | live; enabled modes require named sign-in
# VERITAS_STRIPE_SECRET_KEY=          # matching test/live secret; never commit credentials
# VERITAS_STRIPE_WEBHOOK_SECRET=      # endpoint/CLI signing secret, not the API key
# VERITAS_BILLING_APP_ORIGIN=http://127.0.0.1:5230  # HTTPS required for live mode
VERITAS_RETENTION_DAYS=30
VERITAS_MAX_VIDEO_BYTES=524288000
VERITAS_BINOCULARS_ENABLED=true      # set false on machines with < 8 GB free memory

# Local opt-in audio replacement; legacy keeps the previous detector for rollback.
# See docs/local-audio-rollout.md for scope and calibration limitations.
VERITAS_AUDIO_DETECTOR_MODE=legacy
# Optional development-only repeat search for continuous short audio and video soundtracks.
# VERITAS_AUDIO_WAVEFORM_REPEAT_REVIEW=true

# Local passage inspection and a separate English plain-text email calibration.
# See docs/text-upgrade-evaluation.md for supported inputs and rollback.
VERITAS_TEXT_DETECTOR_MODE=legacy
VERITAS_TEXT_ISOLATED_PARAGRAPH_REVIEW=false
VERITAS_TEXT_PARAGRAPH_EVIDENCE_PRIORITY=false
VERITAS_TEXT_MATCHED_CONTEXT_REVIEW=false
# Optional qualified face-transition review for new analyses; default legacy.
# appearance = v17 appearance cue; sequence = previous review; legacy = no extra review.
# VERITAS_VIDEO_FACE_REVIEW_MODE=appearance
# Optional denser timing for short appearance ranges, with separate before/during/after frames.
# VERITAS_VIDEO_FACE_BOUNDARY_REFINEMENT=true
# Optional second, distinct brief face-change range on qualifying short native videos.
# VERITAS_VIDEO_FACE_SHORT_RETURN_REVIEW=true
# Optional lower-detail repeat for selected coarse ranges in the qualified 4.8-second H.264 profile.
# VERITAS_VIDEO_FACE_DETAIL_REPEAT_REVIEW=true

# Optional sharp rectangular seam inspection on qualifying native RGB PNGs.
# VERITAS_IMAGE_SHARP_BOUNDARY_ENABLED=true
# Optional repeatability check for sensitive regional screening on qualifying PNGs.
# VERITAS_IMAGE_REGION_MODE=candidate
# VERITAS_IMAGE_REGION_FLIP_REVIEW=true

# Optional development-only earlier-copy image comparison, limited to 4-megapixel JPEG and PNG files.
# VERITAS_IMAGE_REFERENCE_COMPARISON_ENABLED=true
# Optional authenticated earlier-clip comparison for completed short videos.
# VERITAS_VIDEO_REFERENCE_COMPARISON_ENABLED=true
# Optional authenticated earlier-draft comparison for completed .eml, .txt and .docx analyses.
# VERITAS_DOCUMENT_REVISION_COMPARISON_ENABLED=true
# Optional development-only source crops and masks for geometrically aligned copy pairs.
# VERITAS_IMAGE_AFFINE_COPY_REVIEW=true
