# Copy to backend/.env. All keys are optional; see app/core/config.py for defaults.
# VERITAS_API_KEY=                   # if set, clients must send X-API-Key; unset in dev: single-user mode on loopback.
#                                    # Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# VERITAS_ENVIRONMENT=dev            # prod: an API key of at least 32 characters, docs off, JSON logs, offline by default
# VERITAS_SIGNING_KEY=               # prod default: the generated data/keys/signing.key, never derived from the API key
# VERITAS_OFFLINE=                   # unset: true in prod, false in dev (PL-01); true refuses every weight download
# VERITAS_FRONTEND_DIR=              # optional absolute path to a built SPA containing index.html
# VERITAS_MODELS_DIR=                # non-HF weights under <dir>/weights (default: VERITAS_DATA_DIR/weights)
VERITAS_DEVICE=auto                  # auto | cuda | mps | cpu
VERITAS_DATA_DIR=./data
# VERITAS_DATABASE_URL=postgresql+psycopg://user:pass@host/veritas
# Hosted Stripe Checkout: one analysis costs USD 9.99. See docs/local-stripe-billing.md.
# VERITAS_BILLING_MODE=disabled       # disabled | test | live; enabled modes require named sign-in
# VERITAS_STRIPE_SECRET_KEY=          # matching test/live secret; never commit credentials
# VERITAS_STRIPE_WEBHOOK_SECRET=      # endpoint/CLI signing secret, not the API key
# VERITAS_BILLING_APP_ORIGIN=http://127.0.0.1:5230  # HTTPS required for live mode
VERITAS_RETENTION_DAYS=30
VERITAS_MAX_VIDEO_BYTES=524288000
VERITAS_BINOCULARS_ENABLED=true      # set false on machines with < 8 GB free memory
# Permit one model load for multiple writing windows in the local CPU fallback.
VERITAS_TEXT_RATIO_COMPACT_CPU=true

# Local opt-in audio replacement; legacy keeps the previous detector for rollback.
# See docs/local-audio-rollout.md for scope and calibration limitations.
VERITAS_AUDIO_DETECTOR_MODE=legacy
# Optional Apple Silicon speech review for three-second mono PCM16 WAV and FLAC in Full analysis.
# See docs/audio-nemotron-noise-transfer-2026-11-12.md for the pinned local assets.
# VERITAS_AUDIO_BACKGROUND_REVIEW_MODEL=/absolute/path/to/model
# VERITAS_AUDIO_BACKGROUND_REVIEW_PACKAGES=/absolute/path/to/python-overlay
# Optional development-only repeat search for continuous short audio and video soundtracks.
# VERITAS_AUDIO_WAVEFORM_REPEAT_REVIEW=true
# Optional fixed-gain and polarity evidence on short native stereo audio and video soundtracks.
# VERITAS_AUDIO_STEREO_GAIN_REPEAT_REVIEW=true
# Optional repeated-sound check after alignment of short native 16 kHz stereo tracks.
# VERITAS_AUDIO_STEREO_ALIGNED_REPEAT_REVIEW=true
# Optional native alignment for short lossless 48 kHz stereo with a verified source clock.
# VERITAS_AUDIO_STEREO_NATIVE_REPEAT_REVIEW=true
# VERITAS_AUDIO_STEREO_AAC_REPEAT_REVIEW=true
# VERITAS_AUDIO_STEREO_TIMING_CHANGE_REVIEW=true
# Optional local repeat search for fixed crop changes in qualified 360p and 720p video.
# VERITAS_VIDEO_CROPPED_SEQUENCE_REVIEW=true

# Local passage inspection and a separate English plain-text email calibration.
# See docs/text-upgrade-evaluation.md for supported inputs and rollback.
VERITAS_TEXT_DETECTOR_MODE=legacy
VERITAS_TEXT_ISOLATED_PARAGRAPH_REVIEW=false
VERITAS_TEXT_PARAGRAPH_EVIDENCE_PRIORITY=false
VERITAS_TEXT_MATCHED_CONTEXT_REVIEW=false
# Optional exact three-sentence English text review. See docs/writing-position-app-2026-11-12.md.
VERITAS_TEXT_PASSAGE_POSITION_REVIEW=false
# Optional exclusion of a clearly structured terminal reference list in local development.
VERITAS_TEXT_BIBLIOGRAPHY_SCOPE_REVIEW=false
VERITAS_TEXT_WITHIN_SENTENCE_LANGUAGE_REVIEW=false
VERITAS_TEXT_CHARACTER_ADJUSTED_REVIEW=false
VERITAS_TEXT_PASSAGE_INTERVALS_REVIEW=false
# Optional document-relative writing ranges when passage interval review is enabled in development.
VERITAS_TEXT_PASSAGE_DOCUMENT_BASELINE_REVIEW=false
# Applies only to eligible writing with both preceding passage checks enabled.
VERITAS_TEXT_PASSAGE_REPORT_REVIEW=false
# Optional resolution of brief competing phrases when a local GAO report comparison is available.
# VERITAS_DOCUMENT_GAO_ARCHIVE_RESOLVE_COMPETITION=false
# Optional qualified face-transition review for new analyses; default legacy.
# appearance = v17 appearance cue; sequence = previous review; legacy = no extra review.
# VERITAS_VIDEO_FACE_REVIEW_MODE=appearance
# VERITAS_VIDEO_WHOLE_FACE_SAME_FRAME_REVIEW=false
# Optional measured face detail check when both preceding face checks finish without a flag.
# VERITAS_VIDEO_WHOLE_FACE_DETAIL_REVIEW=false
# Optional denser timing for short appearance ranges, with separate before/during/after frames.
# VERITAS_VIDEO_FACE_BOUNDARY_REFINEMENT=true
# Optional second, distinct brief face-change range on qualifying short native videos.
# VERITAS_VIDEO_FACE_SHORT_RETURN_REVIEW=true
# Optional same-scene face comparison for fixed four-second 360p H.264 uploads.
# VERITAS_VIDEO_FACE_LOCAL_RETURN_REVIEW=true
# Optional lower-detail repeat for selected coarse ranges in the qualified 4.8-second H.264 profile.
# VERITAS_VIDEO_FACE_DETAIL_REPEAT_REVIEW=true
# Optional timing refinement for retained face ranges in supported 720p30 HEVC clips.
# VERITAS_VIDEO_FACE_PAIRED_EDGE_REFINEMENT=false
# Optional surrounding-picture cut context for an existing face-change range on qualified 720p30 HEVC MP4.
# VERITAS_VIDEO_FACE_SPATIAL_CUT_CONTEXT=false
# Optional standalone picture change and return on supported short videos.
# VERITAS_VIDEO_SCENE_RETURN_REVIEW=true
# VERITAS_VIDEO_RETIMED_SEQUENCE_REVIEW=false
# Optional 3:2 and 4:3 comparisons after the 2:1 review completes with no match.
# VERITAS_VIDEO_FRACTIONAL_RETIMED_SEQUENCE_REVIEW=false
# VERITAS_VIDEO_REFLECTED_SEQUENCE_REVIEW=false
# Optional five- to seven-picture face-change proposals on qualified 720p30 HEVC MP4.
# VERITAS_VIDEO_FACE_UNROUTED_SHORT_REVIEW=false
# VERITAS_VIDEO_FACE_SHORT_WINDOW_REVIEW=false
# Optional brief face evidence for qualified four-second VP9 and overlapping eight-second AVC or VP9 clips.
# VERITAS_VIDEO_FACE_SHORT_CARRIER_REVIEW=false
# Local trial for five- to seven-picture face changes in four-second 720p30 AVC MP4. Requires appearance mode.
# VERITAS_VIDEO_FACE_SHORT_AVC_REVIEW=false
# Local trial for a separate second brief range. Requires the four-second AVC trial above.
# VERITAS_VIDEO_FACE_SECOND_AVC_REVIEW=false
# Optional first-range recovery when the fixed AVC motion scan finds no range.
# VERITAS_VIDEO_FACE_MOVING_AVC_REVIEW=false
# VERITAS_VIDEO_FACE_BOUNDARY_AVC_REVIEW=false
# Local trial for keeping a clearly dominant face in view when a smaller face is detected.
# VERITAS_VIDEO_FACE_PRIMARY_TRACK_AVC_REVIEW=false
# Local trial for tracking the same position when a separate guest changes size.
# VERITAS_VIDEO_FACE_POSITION_TRACK_AVC_REVIEW=false
# Local trial for separate face tracks and surrounding motion in side-by-side video.
# VERITAS_VIDEO_FACE_PANE_TRACK_AVC_REVIEW=false
# Reuse the selected side's measurements to locate a second separate face-change range.
# VERITAS_VIDEO_FACE_SECOND_PANE_AVC_REVIEW=false
# When the pane track and same-side follow-up are enabled, also review a separate range on the other side.
# VERITAS_VIDEO_FACE_OPPOSITE_PANE_AVC_REVIEW=false
# Local two-second speech inspection when the main voice check has no admitted windows.
# VERITAS_AUDIO_SHORT_ADMISSION_REVIEW=false
# In development, review a verified six-second mono AAC-LC presentation for a short speech anomaly.
# VERITAS_AUDIO_SHORT_AAC_REVIEW=false
# Exact six-second 48 kHz mono PCM16 WAV and FLAC in local Full audio analysis.
# VERITAS_AUDIO_SHORT_LOSSLESS_48K_REVIEW=false
# Run a focused speech edit follow-up on supported 16 kHz lossless audio in development.
# VERITAS_AUDIO_FOCUSED_EDIT_REVIEW=false
# VERITAS_AUDIO_FOCUSED_EDIT_LOSSLESS_48K_REVIEW=false
# Optional overlapping speech-window evidence for supported short WAV and FLAC recordings.
# VERITAS_AUDIO_FOCUSED_LONG_REVIEW=false
# Extend the focused review to 48 kHz mono PCM16 WAV using the app's 16 kHz decoding.
# VERITAS_AUDIO_FOCUSED_LONG_48K_REVIEW=false
# Check two-second windows within longer, continuous 16 kHz mono WAV or FLAC.
# VERITAS_AUDIO_TWO_SECOND_LONG_REVIEW=false
# VERITAS_AUDIO_TWO_SECOND_LONG_CONFIRMATION=false
# Confirm speech windows on the original 48 kHz clock for supported 9–14-second mono uploads.
# VERITAS_AUDIO_TWO_SECOND_LONG_48K_REVIEW=false
# VERITAS_AUDIO_TWO_SECOND_LONG_AAC48_REVIEW=false
# Local frequency-drop evidence for 6-, 8- and 12-second native mono PCM16 WAV or FLAC.
# VERITAS_AUDIO_BANDWIDTH_RETURN_REVIEW=false

# Optional sharp rectangular seam inspection on qualifying native RGB PNGs.
# VERITAS_IMAGE_SHARP_BOUNDARY_ENABLED=true
# Optional repeatability check for sensitive regional screening on qualifying PNGs.
# VERITAS_IMAGE_REGION_MODE=candidate
# Optional development-only JPEG regional evidence for standard baseline or progressive quality-75 4:2:0 files.
# VERITAS_IMAGE_REGION_JPEG_REVIEW=true
# With the JPEG review enabled, also inspect supported quality-90 uploads with a repeat view.
# VERITAS_IMAGE_REGION_JPEG90_REVIEW=false
# Optional local comparison with a cropped earlier JPEG grid on supported quality-90 files.
# VERITAS_IMAGE_JPEG_PRIOR_GRID_REVIEW=true
# Optional development-only right-angle copy evidence for eligible JPEGs.
# VERITAS_IMAGE_TURNED_JPEG_COPY_REVIEW=false
# VERITAS_IMAGE_JPEG_NATIVE_ROTATION_REVIEW=false
# Show two independent rotated pairs on the supported larger JPEG profile.
# VERITAS_IMAGE_JPEG_DISJOINT_ROTATION_REVIEW=false
# VERITAS_IMAGE_NATIVE_INTERPOLATION_REVIEW=true
# VERITAS_IMAGE_NATIVE_ROTATION_REVIEW=true
# VERITAS_IMAGE_NATIVE_QUANTIZED_REVIEW=false
# VERITAS_IMAGE_NATIVE_FINE_REVIEW=false
# Also check compact interpolation cores when the earlier native scans have no region.
# VERITAS_IMAGE_NATIVE_CORE_REVIEW=false
# VERITAS_IMAGE_REGION_FLIP_REVIEW=true

# Optional development-only earlier-copy image comparison for JPEG, PNG and eligible lossless WebP.
# VERITAS_IMAGE_REFERENCE_COMPARISON_ENABLED=true
# Compare compatible JPEG exports with an earlier single-frame HEIC photo.
# VERITAS_IMAGE_REFERENCE_HEIF_REVIEW=true
# Compare a simple lossy WebP submission with an earlier lossless copy at the same framing.
# VERITAS_IMAGE_REFERENCE_LOSSY_WEBP=true
# Also compare an earlier copy when the WebP was both cropped and downsized.
# VERITAS_IMAGE_REFERENCE_LOSSY_WEBP_CROP_RESIZE=false
# VERITAS_IMAGE_REFERENCE_LOSSY_WEBP_COLOR=false
# Also compare a same-framing earlier JPEG with the lossy WebP submission.
# VERITAS_IMAGE_REFERENCE_LOSSY_WEBP_EARLIER_JPEG=false
# Optional local comparison of an earlier standard quality-95 JPEG with a cropped RGB PNG.
# VERITAS_IMAGE_REFERENCE_JPEG_PNG_ENVELOPE=true
# Compare the supported interior when an earlier PNG and a submitted JPEG have a small whole-pixel shift.
# VERITAS_IMAGE_REFERENCE_SHIFTED_JPEG=true
# Optional same-framing JPEG comparison after overall tone changes.
# VERITAS_IMAGE_REFERENCE_STRUCTURE_JPEG=true
# Optional exact-block fallback when matching standard quality-90 JPEGs could not be assessed.
# VERITAS_IMAGE_REFERENCE_SAME_JPEG=true
# VERITAS_IMAGE_REFERENCE_JPEG_DETAIL_LOSS=true
# Extend the same-framing detail loss comparison to standard JPEG75 and JPEG85.
# VERITAS_IMAGE_REFERENCE_JPEG_DETAIL_LOSS_EXTRA_QUALITIES=true
# Optional exact small-copy evidence for upright static RGB PNGs.
# VERITAS_IMAGE_SMALL_PNG_COPY_REVIEW=false
# VERITAS_IMAGE_TURNED_PNG_COPY_REVIEW=false
# Optional native comparison for PNGs containing a supported Exif thumbnail.
# VERITAS_IMAGE_PNG_EXIF_PREVIEW_REVIEW=false
# Optional comparison for an HEIC still containing one supported linked thumbnail.
# VERITAS_IMAGE_HEIF_THUMBNAIL_REVIEW=false
# VERITAS_IMAGE_MOTION_PHOTO_REVIEW=false
# Optional supplementary whole-image check in Full development analyses.
# VERITAS_IMAGE_WHOLE_REVIEW_PYTHON=/absolute/path/to/review/runtime/bin/python
# Extend the configured supplementary check to eligible photographic PNGs.
# VERITAS_IMAGE_WHOLE_PNG_REVIEW_ENABLED=true
# Optional authenticated earlier-clip comparison for completed short videos.
# VERITAS_VIDEO_REFERENCE_COMPARISON_ENABLED=true
# VERITAS_VIDEO_REFERENCE_LOCAL_AREA=true
# VERITAS_VIDEO_REFERENCE_MEASURED_INTERVAL=true
# VERITAS_VIDEO_REFERENCE_SOUNDTRACK_REENCODE=true
# VERITAS_VIDEO_REFERENCE_SHORT_SOUNDTRACK=true
# VERITAS_VIDEO_REFERENCE_SOUND_DIFFERENCE=false
# VERITAS_VIDEO_REFERENCE_SHORT_NATIVE_SOUND_DIFFERENCE=false
# VERITAS_VIDEO_REFERENCE_SHORT_PHRASE_DIFFERENCE=false
# VERITAS_VIDEO_REFERENCE_PICTURE_INSERTION=true
# Optional timing comparison of short 16 kHz mono PCM16 WAV or FLAC recordings.
# VERITAS_AUDIO_REFERENCE_COMPARISON_ENABLED=true
# VERITAS_AUDIO_REFERENCE_LOCAL_TIMING=false
# VERITAS_AUDIO_REFERENCE_AAC_TIMING=false
# VERITAS_AUDIO_REFERENCE_CLEAN_SPEECH=false
# VERITAS_AUDIO_REFERENCE_DENSE_CLEAN_SPEECH=false
# Explain broad frequency changes before reporting a local difference in six-second dense comparisons.
# VERITAS_AUDIO_REFERENCE_CLEAN_SPEECH_EQ_GUARD=false
# VERITAS_AUDIO_REFERENCE_CLEAN_SPEECH_AAC=false
# VERITAS_VIDEO_SOUNDTRACK_PAIR_REVIEW=false
# VERITAS_VIDEO_SOUNDTRACK_FREQUENCY_REVIEW=false
# Optional local trial for speech and mouth timing in supported short videos.
# Set the paths to the pinned acoustic checkpoint, face task and optional MediaPipe environment.
# VERITAS_VIDEO_LIP_TIMING_REVIEW=false
# VERITAS_VIDEO_LIP_ARTICULATION_REVIEW=false
# VERITAS_VIDEO_LIP_AAC48_ARTICULATION_REVIEW=false
# VERITAS_VIDEO_LIP_SILENT_MOUTH_REVIEW=false
# VERITAS_VIDEO_LIP_TIMING_MODEL_DIR=/path/to/acoustic/checkpoint
# VERITAS_VIDEO_LIP_TIMING_FACE_ASSET=/path/to/face_landmarker.task
# VERITAS_VIDEO_LIP_TIMING_RUNTIME=/path/to/mediapipe/site-packages
# VERITAS_AUDIO_REFERENCE_LONG_CLEAN_SPEECH=false
# VERITAS_AUDIO_REFERENCE_CLEAN_SPEECH_STEREO_AAC=false
# VERITAS_AUDIO_REFERENCE_STEREO_DENSER_WINDOWS=false
# VERITAS_AUDIO_REFERENCE_STEREO_CLOSE_CONSENSUS=false
# Map earlier wording to clear PDF columns when the local GAO archive review is enabled.
# VERITAS_DOCUMENT_GAO_PDF_COLUMNS_REVIEW=false
# VERITAS_DOCUMENT_PDF_SAVED_WORDING_REVIEW=false
# Optional authenticated earlier-draft comparison for completed .eml, .txt and .docx analyses.
# VERITAS_DOCUMENT_REVISION_COMPARISON_ENABLED=true
# VERITAS_DOCUMENT_PAIRED_BOUNDARY_REVIEW=true
# VERITAS_DOCUMENT_PAIRED_SEPARATE_REVIEW=true
# VERITAS_DOCUMENT_PAIRED_INDEPENDENT_REVIEW=true
# VERITAS_DOCUMENT_PAIRED_BLOCK_REVIEW=false
# Optional text comparison of two supported body renditions in one email.
# VERITAS_DOCUMENT_EMAIL_ALTERNATIVES_REVIEW=false
# VERITAS_DOCUMENT_PERCENTAGE_CONSISTENCY=false
# Optional development-only public archive comparison. A verified GAO highlights pack applies to TXT.
# VERITAS_DOCUMENT_ARCHIVE_COMPARISON_ENABLED=true
# VERITAS_DOCUMENT_PDF_CREDENTIALS=false
# VERITAS_DOCUMENT_GAO_ARCHIVE_PATH=/absolute/path/to/gao-pack.json
# VERITAS_DOCUMENT_GAO_ARCHIVE_SHA256=671287085feaa971c501be2e2db7d50a36ca2a9adba0642c9540f4add35b341e
# Optional development-only source crops and masks for geometrically aligned copy pairs.
# VERITAS_IMAGE_AFFINE_COPY_REVIEW=true
# VERITAS_IMAGE_SMALL_AFFINE_COPY_REVIEW=true
