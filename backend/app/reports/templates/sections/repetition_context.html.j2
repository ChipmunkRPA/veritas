{% if evidence.get('picture_hold') %}
{% set hold = evidence.picture_hold %}
<h3>Identical consecutive frames</h3>
{% if hold.status == 'unavailable' %}<p>{{ hold.reason }}</p>{% else %}
<p>Checked {{ hold.frames_scanned }} frames from the start{% if hold.last_stream_time_s is not none %} through {{ '%.3f' | format(hold.last_stream_time_s) }} s on the source clock{% endif %}. {% if hold.status == 'matched' %}<a href="#multimedia-evidence-{{ hold.packet_id }}">Inspect the recorded hold</a>.{% else %}No qualifying hold was found in that range.{% endif %}</p>
{% set later_frames = evidence.get('picture_frame_count', 0) - hold.frames_scanned %}
{% if later_frames > 0 %}<p class="caption">{{ later_frames }} later {{ 'frame was' if later_frames == 1 else 'frames were' }} outside this check.</p>{% endif %}
{% endif %}
{% if hold.get('continuity_breaks') %}<p class="caption">The scan found {{ hold.continuity_breaks }} gaps or unverifiable transitions in the frame sequence.</p>{% endif %}
<p class="caption">Still cards, capture interruptions, and ordinary editing can repeat a frame. This check carries no AI confidence weight. JSON pointer <span class="mono">/picture_hold</span>.</p>
{% if hold.get('sequence_review') %}
<h3>Repeated moving sequences</h3>
{% if hold.sequence_review.status == 'matched' %}<p><a href="#multimedia-evidence-VPR01">Inspect both matching source ranges</a>.</p>
{% elif hold.sequence_review.status == 'no_match' %}<p>No exact moving sequence repeated within the checked frames.</p>
{% else %}<p>The checked footage did not contain two usable ranges of at least half a second.</p>{% endif %}
{% endif %}
{% if hold.get('motion_sequence_review') %}
{% set motion = hold.motion_sequence_review %}
{% set motion_rate = motion.parameters.frame_rate %}
{% set motion_limit = motion.frames_scanned or motion_rate * 9 %}
<h3>Similar repeated moving sequences</h3>
{% if motion.status == 'matched' %}<p><a href="#multimedia-evidence-VPR02">Inspect both ranges with similar pictures and motion</a>.</p>
{% elif motion.status == 'no_match' %}<p>No qualifying repeat was found in the first {{ motion_limit }} frames.</p>
{% elif motion.reason == 'exact_sequence' %}<p>The exact check already found a moving sequence.</p>
{% else %}<p>This check needs verified {{ 1000 // motion_rate }} ms spacing throughout the first {{ motion_limit }} frames.</p>{% endif %}
<p class="caption">Coverage is limited to the first {{ motion_limit }} native {{ evidence.picture_dimensions[0] }} × {{ evidence.picture_dimensions[1] }} frames in supported {{ motion_rate }} fps video. A repeat may come from ordinary editing and carries no AI confidence weight. JSON pointer <span class="mono">/picture_hold/motion_sequence_review</span>.</p>
{% endif %}
{% if hold.get('mouth_local_hold') %}
{% set mouth = hold.mouth_local_hold %}
<h3>Mouth-region picture hold</h3>
{% if mouth.status == 'matched' %}<p><a href="#multimedia-evidence-{{ mouth.packet_id }}">Inspect the measured mouth region</a> with original pictures from before, during and after the range.</p>
{% elif mouth.status == 'no_match' %}<p>{% if mouth.get('assessed_window_starts') %}No qualifying mouth-region hold was found in the assessed windows.{% else %}No qualifying mouth-region hold was found in the {{ mouth.frames_scanned }} verified pictures.{% endif %}</p>
{% elif mouth.status == 'no_stable_face' %}<p>The check could not establish one consistently visible mouth across the {{ mouth.frames_scanned }} verified pictures.</p>
{% else %}<p>The mouth-region check was unavailable for this analysis.</p>{% endif %}
{% if mouth.get('assessed_window_starts') %}
<p class="caption">The review covers only the first {{ mouth.frames_scanned }} source pictures. Mouth geometry was measured in {{ mouth.assessed_window_starts | length }} of 3 overlapping windows. Source frames {% for start in mouth.assessed_window_starts %}{{ start }}–{{ start + 59 }}{{ '.' if loop.last else ', ' }}{% endfor %}</p>
{% endif %}
<p class="caption">Ordinary editing and compression can create this pattern. It carries no AI confidence weight. JSON pointer <span class="mono">/picture_hold/mouth_local_hold</span>.</p>
{% endif %}
{% endif %}
{% set repeat_reports = [(evidence.get('repetition_context'), false, none, evidence.repetition_context_pointer), (evidence.get('similarity_context'), true, none, evidence.similarity_context_pointer)] %}
{% if evidence.get('stereo_repetition') %}
{% for row in evidence.stereo_repetition.channels %}
{% set _ = repeat_reports.append((row.measurement, false, row.channel, evidence.stereo_repetition_pointer ~ '/channels/' ~ loop.index0 ~ '/measurement')) %}
{% if row.get('gain_measurement') %}{% set _ = repeat_reports.append((row.gain_measurement, false, row.channel, evidence.stereo_repetition_pointer ~ '/channels/' ~ loop.index0 ~ '/gain_measurement')) %}{% endif %}
{% endfor %}
{% endif %}
{% for context, similar, channel, pointer in repeat_reports if context %}
{% set waveform = context.schema == 'chipmunk.audio-repeat-similarity/2' %}
{% set gain = context.schema == 'chipmunk.audio-gain-repetition/1' %}
<h3>{% if channel %}{{ 'Gain-adjusted' if gain else 'Exact' }} repeats in the {{ channel }} channel{% elif similar %}Similar repeated audio{% else %}Exact repeated audio{% endif %}</h3>
<p>{% if gain %}This check compares the recorded channel for exact repeats after a fixed level or polarity change. Mixing new sound into that channel can hide repeats.{% elif channel %}This check compares the recorded channel before it is mixed into mono.{% elif waveform %}The exact and frequency-band searches yielded no reportable pair. A second similarity check compared waveform patterns in the same continuous 2.5–4 second mono input. Background noise can mask repeats.{% elif similar %}This check compares patterns across frequency bands in continuous 2.5–4 second mono inputs. Background noise can mask repeats.{% else %}This check compares samples in continuous 2.5–4 second mono inputs.{% endif %} Loops, recurring alerts, and editing can all repeat audio. Matches carry no AI confidence weight.</p>
{% if context.status == 'ambiguous' %}<p>{{ 'The waveform search could not establish a reliable pair.' if waveform else 'The search reached its comparison limit before it could establish a result.' }}</p>
{% elif context.status == 'unavailable' %}<p>This input could not be checked within the supported duration, source timing, and signal conditions.</p>
{% elif not context.pairs %}<p>No {{ 'gain-adjusted' if gain else 'waveform' if waveform else 'similar' if similar else 'exact active' }} repeat of at least 0.15 seconds was found in the checked input.{% if waveform and context.frequency_band_search.status != 'measured' %} The frequency-band search was inconclusive.{% endif %}</p>{% endif %}
{% for pair in context.pairs %}
<article class="multimedia-evidence-packet multimedia-repeat-pair" id="multimedia-evidence-{{ pair.id }}">
<h4>{{ pair.id }} · {{ '%.3f' | format(pair.sample_count / context.sample_rate) }} s of {{ 'samples matched after a gain adjustment' if gain else 'similar sound' if similar else 'identical samples' }}</h4>
{% if gain %}<p>Multiplying the {{ 'first' if pair.scaled_occurrence == 'second' else 'second' }} occurrence by {{ pair.gain_numerator }}/{{ pair.gain_denominator }} and rounding to recorded precision reproduces the {{ pair.scaled_occurrence }} occurrence. These ranges can include matching silence. The edit boundaries and order are unknown.</p>{% endif %}
{% if pair.get('waveform') %}{{ plates([pair.waveform]) }}{% endif %}
{% for label in ['first', 'second'] %}
{% set span = pair[label] %}
{% if gain %}{{ plates([pair[label ~ '_waveform']]) }}{% endif %}
<p>{{ label | capitalize }} occurrence, analyzed audio {{ '%.3f' | format(span.start_sample / context.sample_rate) }}–{{ '%.3f' | format(span.end_sample / context.sample_rate) }} s. Samples [{{ span.start_sample }}, {{ span.end_sample }}).</p>
{% for range in span.source_timestamp_ranges %}
<p class="caption">Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.
{% set origin = evidence.stereo_context_video_origin_s %}
{% set start = range.source_start_pts / context.sample_rate %}
{% set end = range.source_end_pts / context.sample_rate %}
{% if origin is not none and start >= origin %}Video playback {{ '%.3f' | format(start - origin) }}–{{ '%.3f' | format(end - origin) }} s.{% endif %}</p>
{% endfor %}
{% if similar or gain %}<p class="caption evidence-hash">WAV SHA-256 <span class="mono">{{ pair.artifacts[label ~ '_clip'].sha256 }}</span>. Decoded sample SHA-256 <span class="mono">{{ span.pcm_s16le_sha256 }}</span>.</p>{% endif %}
{% endfor %}
{% if not similar and not gain %}<p class="caption evidence-hash">{% if not evidence.withheld %}The evidence ZIP includes one WAV for both locations. {% endif %}WAV SHA-256 <span class="mono">{{ pair.artifacts.first_clip.sha256 }}</span>. Decoded sample SHA-256 <span class="mono">{{ pair.pcm_s16le_sha256 }}</span>.</p>{% endif %}
</article>
{% endfor %}
<p class="caption">JSON pointer <span class="mono">{{ pointer }}</span>.</p>
{% endfor %}
{% if evidence.get('repeated_passages') %}
{% set repeated = evidence.repeated_passages %}
<h3>Exact repeated passages</h3>
<p>Compared {{ repeated.coverage.compared_blocks }} mapped text blocks of at least 30 words and at most 1,600 characters. Quotes, templates, and editorial duplication can repeat wording. Matches carry no AI confidence weight.</p>
{% if repeated.coverage.excluded_ocr_blocks %}<p class="caption">Excluded {{ repeated.coverage.excluded_ocr_blocks }} blocks read from page images.</p>{% endif %}
{% if repeated.coverage.excluded_quoted_or_signature_blocks %}<p class="caption">Excluded {{ repeated.coverage.excluded_quoted_or_signature_blocks }} blocks marked as email quotations or signatures.</p>{% endif %}
{% if repeated.status == 'not_assessed' %}<p>There were too few eligible blocks to compare.</p>
{% elif repeated.status == 'no_match' %}<p>No exact repeat was found among the compared blocks.</p>{% endif %}
{% for group in repeated.groups %}
<article class="multimedia-evidence-packet" id="multimedia-evidence-{{ group.id }}">
<h4>{{ group.id }} · {{ group.word_count }} words repeated at {{ group.total_occurrences }} locations</h4>
{% if not evidence.withheld %}<blockquote>{{ group.text }}</blockquote>{% endif %}
<ul>{% for location in group.occurrences %}
{% set anchor = location.anchor %}
<li>{% if anchor.kind == 'pdf' %}Page {{ anchor.page }}{% if anchor.get('block') is not none %}, block {{ anchor.block + 1 }}{% endif %}. {% elif anchor.kind == 'docx' %}Paragraph {{ anchor.paragraph_index + 1 }}. {% elif anchor.kind == 'email' %}Email body. {% endif %}Extracted characters [{{ location.start }}, {{ location.end }}).{% if anchor.get('source_start') is not none %} Source characters [{{ anchor.source_start }}, {{ anchor.source_end }}).{% endif %}{% if anchor.get('bbox') %} Bounds [{% for value in anchor.bbox %}{{ '%.1f' | format(value) }}{% if not loop.last %}, {% endif %}{% endfor %}] on the unrotated page.{% endif %}</li>
{% endfor %}</ul>
{% if group.total_occurrences > group.occurrences | length %}<p class="caption">Showing the first {{ group.occurrences | length }} locations.</p>{% endif %}
</article>
{% endfor %}
{% if repeated.coverage.omitted_groups %}<p class="caption">{{ repeated.coverage.omitted_groups }} additional repeat groups are outside the evidence display limit.</p>{% endif %}
<p class="caption">JSON pointer <span class="mono">/repeated_passages</span>.</p>
{% endif %}
