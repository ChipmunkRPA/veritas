  "source_plan": {
    "extraction": "Read horizontal single-column discussion manuscript text after an exact Introduction heading. Omit running headers, line-number gutters, separate headings, captions and unsupported content. Match final publisher JATS body prose, keeping source names and dates private.",
    "geometry": "Use one five-sentence source-ordered body excerpt per work with two exact common sentences on each side and a changed center of 12\u201340 words. Require a material lexical edit after removing citation and hyphenation artifacts. Keep source PDF page and line bounding boxes and final body offsets.",
    "max_bytes": {
      "after": 600000,
      "before": 2000000
    },
    "pool_size": 20,
    "previous_public_sha256": "ee45589adf1557c5c851fd613c1374817ec4090e477509db3677f43cc93cfbb5",
