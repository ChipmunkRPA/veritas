{"created": "2026-04-12T03:47:49.695166+00:00", "modified": "2026-04-12T03:47:50.215231+00:00", "id": 19522979, "conceptrecid": "19362790", "doi": "10.5281/zenodo.19522979", "conceptdoi": "10.5281/zenodo.19362790", "doi_url": "https://doi.org/10.5281/zenodo.19522979", "metadata": {"title": "PhonemeDF: A Synthetic Speech Dataset for Audio Deepfake Detection and Naturalness Evaluation", "doi": "10.5281/zenodo.19522979", "publication_date": "2026-04-11", "description": "<p>PhonemeDF is a large-scale phoneme-level parallel dataset of real and synthetic speech (approximately 730 hours), designed for audio deepfake detection and speech naturalness evaluation.</p>\n<p>The dataset consists of real speech samples derived from a subset of the LibriSpeech corpus (train-clean-100) and corresponding synthetic speech generated using four Text-to-Speech (TTS) systems (MeloTTS, XTTS v2, Chatterbox TTS, and VITS) and three Voice Conversion (VC) systems (Chatterbox VC, FreeVC, and StarGAN VC). Each audio sample is paired with phoneme-level alignments obtained using the Montreal Forced Aligner (MFA) with the ARPAbet phoneme set.&nbsp;</p>\n<p>The dataset contains 28,539 real utterances and 199,773 synthetic utterances, totaling approximately 730 hours of speech, along with corresponding TextGrid files. All audio is standardized to 16 kHz.</p>\n<h2>&nbsp;</h2>\n<h2>RESOURCES</h2>\n<p>Code and additional resources:<br><a href=\"https://github.com/Vamshi-Nallaguntla/PhonemeDF\">https://github.com/Vamshi-Nallaguntla/PhonemeDF</a></p>\n<p>Paper (arXiv):<br><a href=\"https://doi.org/10.48550/arXiv.2603.15037\">https://doi.org/10.48550/arXiv.2603.15037</a></p>\n<div>&nbsp;</div>", "access_right": "open", "creators": [{"name": "Nallaguntla, Vamshi", "affiliation": "Wichita State University", "orcid": "0009-0006-3257-7535"}, {"name": "Fursule, Aishwarya", "affiliation": "Wichita State University", "orcid": "0009-0003-8102-4185"}, {"name": "Kshirsagar, Shruti", "affiliation": "Wichita State University", "orcid": "0000-0002-7191-4251"}, {"name": "Avila, Anderson R.", "affiliation": "Institut National de la Recherche Scientifique", "orcid": "0000-0002-3088-5116"}], "keywords": ["Audio Deepfake Detection", "Montreal Forced Aligner", "LibriSpeech", "Speech Dataset", "Synthetic Speech Dataset", "Phoneme-level Alignment", "Text-to-Speech (TTS)", "Voice Conversion (VC)", "Speech Processing", "Deep Learning"], "related_identifiers": [{"identifier": "10.48550/arXiv.2603.15037", "relation": "isDescribedBy", "resource_type": "publication-conferencepaper", "scheme": "doi"}], "dates": [{"type": "created", "start": "2025-03", "end": "2025-06"}], "version": "1.0.1", "language": "eng", "custom": {"code:codeRepository": "https://github.com/Vamshi-Nallaguntla/PhonemeDF", "code:programmingLanguage": [{"id": "python", "title": {"en": "Python"}}]}, "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "19362790"}}]}}, "title": "PhonemeDF: A Synthetic Speech Dataset for Audio Deepfake Detection and Naturalness Evaluation", "links": {"self": "https://zenodo.org/api/records/19522979", "self_html": "https://zenodo.org/records/19522979", "preview_html": "https://zenodo.org/records/19522979?preview=1", "doi": "https://doi.org/10.5281/zenodo.19522979", "self_doi": "https://doi.org/10.5281/zenodo.19522979", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19522979", "reserve_doi": "https://zenodo.org/api/records/19522979/draft/pids/doi", "parent": "https://zenodo.org/api/records/19362790", "parent_html": "https://zenodo.org/records/19362790", "parent_doi": "https://doi.org/10.5281/zenodo.19362790", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19362790", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:19522979/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:19522979/sequence/default", "files": "https