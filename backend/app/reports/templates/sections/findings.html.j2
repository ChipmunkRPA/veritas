<section class="chapter-cont" id="section-findings">
<h2 class="chapter-title"><span class="n">{{ v.number.findings }}</span>Findings and supporting evidence</h2>
<p class="caption intro">Each finding separates the observation from its interpretation and links to the supporting record. A finding's direction is not a separate confidence percentage. Inspection-only checks are identified explicitly.</p>
{% if v.findings %}
<ol class="finding-list">
{% for f in v.findings %}
<li id="{{ f.anchor }}">
{% if f.thumbnail %}<div class="f-thumb"><img src="{{ f.thumbnail }}" alt="{{ f.thumbnail_alt }}"></div>{% endif %}
<div class="f-body">
<p class="f-head"><span class="fid">{{ f.id }}</span><span class="strength">{% if f.mark %}{{ v.marks[f.mark] }}{% else %}<span class="meter">{% for n in range(4) %}<i class="{{ 'on' if n < f.bars else 'off' }}"></i>{% endfor %}</span>{% endif %}</span></p>
<p class="f-title">{{ f.title | symbols }}</p>
{% if f.get('inference') %}
<p class="finding-inference"><strong>Inference:</strong> {{ f.inference }}</p>
{% for t in f.observations %}<p><strong>Observed:</strong> {{ t | symbols }}</p>{% endfor %}
{% if f.scope_note %}<p class="caption">{{ f.scope_note }}</p>{% endif %}
{% if f.support %}
<ul class="finding-source-links">{% for evidence in f.support[:3] %}<li><a class="xref" href="{{ evidence.href }}">{{ evidence.label }}</a>{% if not evidence.direct %} (related check input){% endif %}</li>{% endfor %}</ul>
{% if f.support | length > 3 %}<p class="caption">Additional recorded locations: {% for evidence in f.support[3:] %}<a href="{{ evidence.href }}">{{ evidence.id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
{% endif %}
{% else %}
{% for t in f.sentences %}
<p>{{ t | symbols }}</p>
{% endfor %}
{% endif %}
{% if f.thumbnail and f.thumbnail_caption %}<p class="caption">{{ f.thumbnail_caption }}</p>{% endif %}
{% for n in f.notes %}
<p class="caption">{{ n | symbols }}</p>
{% endfor %}
{% if f.refs %}
<p class="refs">Evidence: {% for r in f.refs %}<a class="xref" href="{{ r.href }}">{{ r.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif %}
{% if f.disposition %}
<p class="examiner"><span class="ex-label">Examiner</span> {{ f.disposition.status }} · {{ f.disposition.author }}, {{ f.disposition.at }}{% if f.disposition.note %} · {{ f.disposition.note }}{% endif %}</p>
{% endif %}
</div>
</li>
{% endfor %}
</ol>
{% if v.findings | selectattr("thumbnail") | list %}<p class="caption">{{ v.thumbnail_note }}</p>{% endif %}
{% else %}
<p class="muted">{{ v.findings_none }}</p>
{% endif %}
</section>
