<section class="chapter-cont" id="section-findings">
<h2 class="chapter-title"><span class="n">{{ v.number.findings }}</span>Key findings</h2>
<p class="caption intro">Findings in rank order. Strength words follow likelihood-ratio bands (section {{ v.number.methods }}); the direction is toward or against AI generation or manipulation. Examiner dispositions are a separate layer, marked Examiner.</p>
{% if v.findings %}
<ol class="finding-list">
{% for f in v.findings %}
<li id="{{ f.anchor }}">
{% if f.thumbnail %}<div class="f-thumb"><img src="{{ f.thumbnail }}" alt="{{ f.thumbnail_alt }}"></div>{% endif %}
<div class="f-body">
<p class="f-head"><span class="fid">{{ f.id }}</span><span class="strength">{% if f.mark %}{{ v.marks[f.mark] }}{% else %}<span class="meter">{% for n in range(4) %}<i class="{{ 'on' if n < f.bars else 'off' }}"></i>{% endfor %}</span>{% endif %}</span></p>
<p class="f-title">{{ f.title | symbols }}</p>
{% for t in f.sentences %}
<p>{{ t | symbols }}</p>
{% endfor %}
{% if f.thumbnail and f.thumbnail_caption %}<p class="caption">{{ f.thumbnail_caption }}</p>{% endif %}
{% for n in f.notes %}
<p class="caption">{{ n | symbols }}</p>
{% endfor %}
{% if f.refs %}
<p class="refs">Evidence: {% for r in f.refs %}<a class="xref" href="{{ r.href }}">{{ r.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif %}
{% if f.disposition %}
<p class="examiner"><span class="ex-label">Examiner</span> {{ f.disposition.status }} · {{ f.disposition.author }}, {{ f.disposition.at }}{% if f.disposition.note %} · {{ f.disposition.note }}{% endif %}</p>
{% endif %}
</div>
</li>
{% endfor %}
</ol>
{% if v.findings | selectattr("thumbnail") | list %}<p class="caption">{{ v.thumbnail_note }}</p>{% endif %}
{% else %}
<p class="muted">{{ v.findings_none }}</p>
{% endif %}
</section>
