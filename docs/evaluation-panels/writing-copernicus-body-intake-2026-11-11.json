    "publisher": "copernicus",
    "pymupdf": "1.28.2",
    "schema": "chipmunk.writing-copernicus-body-holdout/1",
    "source": "Use only existing DOI-linked Copernicus roster metadata, excluding the two scored abstract works and the source-only PDF scout. Require both per-version commercial CC BY terms and matching original author names. Freeze the first 20 eligible works in existing committed order before accessing bodies."
  },
