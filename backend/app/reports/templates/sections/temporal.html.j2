{% if v.temporal %}
{% set t = v.temporal %}
<section class="chapter-cont" id="section-temporal">
<h2 class="chapter-title"><span class="n">{{ v.number.temporal }}</span>Temporal analysis</h2>
{% if t.lanes %}
<table class="lanes">
<thead><tr><th class="lane-label">Lane</th><th class="lane-chart"><p class="axis-labels">{% for x in t.ticks %}<span>{{ x }}</span>{% endfor %}</p></th></tr></thead>
<tbody>
{% for l in t.lanes %}
<tr><td class="lane-label">{{ l.label }}<br><span class="caption">{{ l.estimate }}</span></td><td class="lane-chart">{{ l.svg }}</td></tr>
{% endfor %}
</tbody>
</table>
{% if t.inspection %}
<p class="caption">{{ t.inspection_caption }}</p>
{% else %}
<p class="caption">Segments are drawn by the step of their peak value: light for steps 1–3, solid with a top rule for steps 4–5. A check’s own estimate comes from the part of the fusion model calibrated for it; segment peaks are smoothed window values and are not calibrated.</p>
{% endif %}
{% else %}
<p class="muted">No time segments were recorded for this analysis.</p>
{% endif %}
<h3 class="eyebrow">Segments</h3>
{% if t.segments %}
<table class="grid">
<thead><tr><th>Segment</th><th>Lane</th><th>Channel</th><th>Track</th><th>Time</th><th class="num">{{ "Peak (not shown)" if t.inspection else "Peak" }}</th><th>Signals</th></tr></thead>
<tbody>
{% for r in t.segments %}
<tr><td class="mono">{{ r.id }}</td><td>{{ r.lane }}</td><td>{{ r.channel }}</td><td>{{ r.track }}</td><td class="mono">{{ r.time }}</td><td class="num mono">{{ r.peak }}</td><td class="mono">{{ r.sources }}</td></tr>
{% endfor %}
</tbody>
</table>
{% elif not t.uncounted %}
<p class="muted">No segments.</p>
{% endif %}
{% if t.uncounted %}
<p class="caption">{{ t.uncounted }}</p>
{% endif %}
<h3 class="eyebrow">Face tracks</h3>
{% if t.tracks %}
{% for x in t.tracks %}
<div class="track">
<p><strong>{{ x.label }}</strong> · {{ x.frames }} frames · <a class="xref" href="#{{ x.anchor }}">{{ x.fig }}</a></p>
{% if x.stills %}<div class="stills">{% for u in x.stills %}<img src="{{ u }}" alt="Still of {{ x.label }}">{% endfor %}</div>{% endif %}
</div>
{% endfor %}
{% else %}
<p class="muted">No face tracks were recorded.</p>
{% endif %}
</section>
{% endif %}
