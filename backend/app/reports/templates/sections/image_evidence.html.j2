{% if v.get('image_evidence') and not v.image_evidence.available %}<p class="caption evidence-unavailable">{{ v.image_evidence.note }}</p>{% endif %}
{% if v.get('image_evidence') and v.image_evidence.available %}
{% set similarity = v.image_evidence.get('copy_similarity') %}
{% set translation = v.image_evidence.get('copy_translation') %}
{% set affine = v.image_evidence.get('copy_affine') %}
{% set exact_pair = v.image_evidence.get('embedded_pair_difference') %}
{% set native_interpolation = v.image_evidence.get('native_interpolation_review') %}
{% set jpeg_grid = v.image_evidence.get('jpeg_prior_grid_review') %}
{% set printed_ids = v.image_evidence.get('printed_identifier_comparison') %}
{% set printed_totals = v.image_evidence.get('printed_total_comparison') %}
{% set evidence_detail = v.image_evidence.packets or v.image_evidence.get('inspection_checks') or (similarity and similarity.pairs) or (translation and translation.pairs) or (affine and affine.pairs) or (exact_pair and exact_pair.pair) or native_interpolation or jpeg_grid or printed_ids or printed_totals %}
<section class="{% if evidence_detail %}chapter{% else %}chapter-cont{% endif %} image-evidence{% if s.report.profile in ['summary', 'newsroom'] and evidence_detail %} evidence-appendix{% endif %}" aria-labelledby="image-evidence-heading">
<h2 class="chapter-title" id="image-evidence-heading">{% if v.get('number', {}).get('source-evidence') %}<span class="n">{{ v.number['source-evidence'] }}</span>{% endif %}Image evidence</h2>
<p>{{ v.image_evidence.note }}</p>
{% if v.image_evidence.available %}
<p class="caption">Evidence set {{ v.image_evidence.version }} · <span class="mono">{{ v.image_evidence.sha256 }}</span></p>
<p class="caption">Coordinates are in the EXIF-oriented original, {{ v.image_evidence.source.width }} × {{ v.image_evidence.source.height }} pixels.</p>
{% if v.image_evidence.withheld %}<p class="caption">Source images and crops are withheld in this redacted copy. The evidence references and observations remain available.</p>{% endif %}
{% if printed_ids %}
<article class="image-evidence-packet">
<h3>{{ printed_ids.title }}</h3>
{% if printed_ids.fields %}
<p>The printed {{ printed_ids.field }} and its confirmation show different values.</p>
<div class="evidence-plates evidence-plates-identifiers">{% for item in printed_ids.fields %}<figure><img src="{{ item.uri }}" alt="{{ item.label }}"><figcaption>{{ item.label }} <span class="mono">{{ item.value }}</span><br>Source columns [{{ item.region[0] }}, {{ item.region[2] }}) and rows [{{ item.region[1] }}, {{ item.region[3] }}).</figcaption></figure>{% endfor %}</div>
{% else %}<p>The printed entry and its confirmation differ. The values and crops are withheld in this copy.</p>{% endif %}
<p class="caption">{{ printed_ids.limitation }} JSON pointer <span class="mono">/printed_identifier_comparison</span>.</p>
</article>
{% endif %}
{% if printed_totals %}
<article class="image-evidence-packet" id="image-evidence-printed-total">
<h3>{{ printed_totals.title }}</h3>
{% if printed_totals.fields %}
{% if printed_totals.basis %}
{% if printed_totals.basis == 'tax_included' %}<p>The printed subtotal already includes tax.</p>{% endif %}
<p>Calculated total {% for field in printed_totals.fields if field.role != 'total' %}{% if field.role == 'tax' %} + {% elif field.role == 'discount' %} − {% endif %}<a class="mono" href="#printed-amount-{{ field.role }}" title="{{ field.label }} in the original image">{{ field.printed[1:] if field.role == 'discount' else field.printed }}</a>{% endfor %} = <strong class="mono">{{ printed_totals.calculated }}</strong>.</p>
<p>Printed total <a class="mono" href="#printed-amount-total" title="Printed total in the original image">{{ printed_totals.printed }}</a>.</p>
{% else %}
<p>The <a href="#printed-amount-subtotal">subtotal</a> plus <a href="#printed-amount-tax">tax</a> is <strong class="mono">{{ printed_totals.calculated }}</strong>. The <a href="#printed-amount-total">printed total</a> is <strong class="mono">{{ printed_totals.printed }}</strong>.</p>
{% endif %}
<div class="evidence-plates evidence-plates-totals">
{% for field in printed_totals.fields %}
<figure id="printed-amount-{{ field.role }}"><img src="{{ field.uri }}" alt="{{ field.label }} row in the original image">
{% set amount = field.amount_region %}
<figcaption>{{ field.label }} <span class="mono">{{ field.printed }}</span>. Amount columns [{{ amount[0] }}, {{ amount[2] }}) and rows [{{ amount[1] }}, {{ amount[3] }}).</figcaption></figure>
{% endfor %}
</div>
{% elif printed_totals.basis %}<p>The compared amounts do not add up to the printed total. The values and crops are withheld in this copy.</p>
{% else %}<p>The subtotal plus tax differs from the printed total. The values and crops are withheld in this copy.</p>{% endif %}
<p class="caption">{{ printed_totals.limitation }} JSON pointer <span class="mono">/printed_total_comparison</span>.</p>
</article>
{% endif %}
{% if jpeg_grid %}
{% set reading = jpeg_grid.record %}
<article class="image-evidence-packet">
<h3>Local JPEG compression history</h3>
<p>{{ reading.observation }}</p>
{% if reading.basis %}<p>{{ reading.basis }}</p>{% endif %}
{% if reading.region %}
<p class="caption">Compared {{ reading.measurement.supported_cells[0] }} measured cells inside the rectangle and {{ reading.measurement.supported_cells[1] }} around it.</p>
<p class="caption">Source columns [{{ reading.region[0] }}, {{ reading.region[2] }}) and rows [{{ reading.region[1] }}, {{ reading.region[3] }}). Right and bottom edges are exclusive.</p>
{% if not v.image_evidence.withheld %}
<div class="evidence-plates">{% for image in jpeg_grid.images %}<figure><img src="{{ image.uri }}" alt="{{ image.label }}"><figcaption>{{ image.label }}</figcaption></figure>{% endfor %}</div>
{% endif %}
{% endif %}
<p class="caption">{{ reading.scope }} {{ reading.limitation }} JSON pointer <span class="mono">/jpeg_prior_grid_review</span>.</p>
</article>
{% endif %}
{% if native_interpolation %}
{% set reading = native_interpolation.record %}
<h3>Local pixel interpolation</h3>
<p>{{ reading.observation }}</p>
{% if reading.get('basis') %}<p class="caption">{{ reading.basis }}</p>{% endif %}
{% if reading.get('quantized_pattern') %}<p class="caption">Stored pixel-value step {{ reading.quantized_pattern.code_step }}. At least {{ '%.1f'|format(100 * reading.quantized_pattern.minimum_channel_fraction) }}% of the measured values in each color channel followed that step.</p>{% endif %}
<p class="caption">{{ reading.scope }} {{ reading.limitation }}</p>
{% if reading.supported_cells %}<p class="caption">{{ reading.supported_cells }} of {{ "{:,}".format((v.image_evidence.source.width // 32) * (v.image_evidence.source.height // 32)) }} native image cells supplied comparable measurements.</p>{% endif %}
{% if reading.region %}<p class="caption">Source columns [{{ reading.region[0] }}, {{ reading.region[2] }}) and rows [{{ reading.region[1] }}, {{ reading.region[3] }}). Right and bottom edges are exclusive.</p>{% endif %}
{% if not v.image_evidence.withheld %}
<div class="evidence-plates">{% for image in native_interpolation.images %}<figure><img src="{{ image.uri }}" alt="{{ image.label }}"><figcaption>{{ image.label }}</figcaption></figure>{% endfor %}</div>
{% endif %}
{% endif %}
{% if similarity and similarity.status == 'skipped_trusted_ai_credentials' %}
<p>{{ similarity.observation }}</p>
{% else %}
{% for check, title, label in [(similarity, 'Same-image copy similarity', 'Reflected pair'), (translation, 'Copy similarity without mirroring', 'Non-mirrored pair'), (affine, 'Geometric copy comparison', 'Matched source areas')] if check %}
<div class="image-regional-comparison">
<h3>{{ check.get('title', title) }}</h3>
<p>{{ check.observation }}</p>
<p class="caption">{{ check.interpretation }}</p>
{% if check.get('diagonal_reflection') or check.schema in ['same-image-copy-similarity/1', 'same-image-affine-support/1', 'same-image-affine-support/2'] %}<p class="caption">This check carries zero weight in AI authorship confidence.</p>{% endif %}
{% if check.get('proposal_search') and check.proposal_search.basis == 'reduced' %}<p class="caption">The candidate search used a {{ check.proposal_search.width }} × {{ check.proposal_search.height }} pixel working image. The check measured any matching masks on the original pixel grid.</p>{% endif %}
{% if check.get('basis_text') %}<p class="caption">{{ check.basis_text }}</p>{% endif %}
{% for pair in check.pairs %}
<article class="image-evidence-packet" id="image-evidence-{{ pair.id }}">
<h4>{{ pair.id }} · {{ 'Exact diagonal reflection' if check.get('diagonal_reflection') else 'Exact reflected pair' if check.get('basis') in ['webp_exact_reflected_copy', 'png_exact_reflected_copy'] or check.get('basis') == 'lossless_exact_disjoint' and pair.get('transform') in ['horizontal_reflection', 'vertical_reflection'] else 'Rotated JPEG pair' if check.get('basis') == 'jpeg_turned_copy' else 'Diagonally aligned JPEG pair' if check.get('basis') == 'jpeg_diagonal_copy' else 'Exact rotated pair' if pair.get('transform') in ['rotate_90_ccw', 'rotate_180'] else 'Exact copy pair' if check.get('basis') in ['webp_exact_copy', 'lossless_exact_disjoint'] else label }}</h4>
{% if pair.get('rotation_text') %}<p class="caption">{{ pair.rotation_text }}</p>{% endif %}
{% if pair.get('selected_pixels') %}<p class="caption">White shows the selected comparison area. Area A contains {{ pair.selected_pixels.area_a }} selected pixels. Its projection onto Area B covers {{ pair.selected_pixels.area_b }} pixels.</p>{% endif %}
<div class="evidence-plates {% if pair.get('selected_pixels') %}evidence-plates-four{% else %}evidence-plates-pair{% endif %}{% if check.get('basis') == 'lossless_exact_disjoint' %} exact-pixel-plates{% endif %}">
{% for image in pair.images %}
{% set region = pair.regions[image.role] %}
<figure>
{% if image.uri %}<img src="{{ image.uri }}" alt="{{ image.label }}">{% endif %}
<figcaption>{{ image.label }} · x {{ region.x }}, y {{ region.y }}, {{ region.w }} × {{ region.h }} px</figcaption>
</figure>
{% endfor %}
</div>
{% for image in pair.images %}<p class="caption evidence-asset-hashes">{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span></p>{% endfor %}
</article>
{% endfor %}
</div>
{% endfor %}
{% endif %}
{% if exact_pair and exact_pair.status != 'skipped_trusted_ai_credentials' %}
<div class="image-regional-comparison">
<h3>Pixel differences between matching areas</h3>
<p>{{ exact_pair.observation }}</p>
{% if exact_pair.pair %}
{% set pair = exact_pair.pair %}
<p class="caption">{{ exact_pair.interpretation }}</p>
<article class="image-evidence-packet" id="image-evidence-{{ pair.id }}">
<h4>{{ pair.id }} · {{ pair.different_pixels }} differing pixels in each area</h4>
<div class="evidence-plates evidence-plates-four evidence-plates-pair">
{% for image in pair.images if image.role != 'difference_mask' %}
{% set region = pair.regions.area_a if image.role in ['area_a', 'overlay_a'] else pair.regions.area_b %}
<figure>{% if image.uri %}<img src="{{ image.uri }}" alt="{{ image.label }}">{% endif %}
<figcaption>{{ image.label }} · x {{ region.x }}, y {{ region.y }}, {{ region.w }} × {{ region.h }} px</figcaption></figure>
{% endfor %}
</div>
{% for label, region in [('Area A', pair.difference_regions.area_a), ('Area B', pair.difference_regions.area_b)] %}
<p class="caption">{{ label }} difference bounds x {{ region.x }}, y {{ region.y }}, {{ region.w }} × {{ region.h }} px.</p>
{% endfor %}
{% for image in pair.images %}<p class="caption evidence-asset-hashes">{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span></p>{% endfor %}
</article>
{% endif %}
</div>
{% endif %}
{% if v.image_evidence.get('comparison') %}
{% set comparison = v.image_evidence.comparison %}
<div class="image-regional-comparison">
<h3>Compare local editing cues</h3>
<p>{{ comparison.interpretation }}</p>
{% if comparison.status == 'unavailable' %}<p>A shared regional view is unavailable for this result. This does not establish that the image is unaltered.</p>
{% else %}
{% if comparison.status != 'ready' %}<p class="caption">Some eligible regions are not shown. This comparison covers the retained evidence cards only.</p>{% endif %}
{% if not v.image_evidence.withheld %}
<div class="evidence-plates evidence-plates-four">
{% for image in comparison.images %}<figure><img src="{{ image.uri }}" alt="{{ image.label }}"><figcaption>{{ image.label }}</figcaption></figure>{% endfor %}
</div>
<p class="caption">Orange marks cells selected by either check; purple marks cells selected by both. White mask cells are selected; black cells are not verified original. A single shared cell is retained.</p>
{% endif %}
<p class="caption">Wider view: {{ comparison.counts.wider }} measured cells. Shared view: {{ comparison.counts.shared }} measured cells. Measured grid {{ comparison.map_grid | join(' × ') }}. Larger previews do not add pixel detail.{% if comparison.counts.shared == 0 %} No shared cells were selected; disagreement does not clear the file.{% endif %}</p>
{% endif %}
{% for member in comparison.members %}<p class="caption">{{ member.label }}: {{ {'measured': 'Measured', 'withheld': 'Candidate regions withheld', 'missing': 'Not available', 'failed': 'Check failed', 'skipped': 'Check skipped', 'unavailable': 'Evidence unavailable'}[member.status] }}.{% if member.packet_ids %} Retained regions: {% for id in member.packet_ids %}<a href="#image-evidence-{{ id }}">{{ id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>{% endfor %}
{% for note in comparison.limitations %}<p class="caption">{{ note }}</p>{% endfor %}
{% for image in comparison.images %}<p class="caption evidence-asset-hashes">{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span></p>{% endfor %}
</div>
{% endif %}
{% if v.image_evidence.get('inspection_checks') %}
<div class="image-inspection-checks">
<h3>How inspection regions were selected</h3>
<p class="caption">The image gate controls candidate display. The reliability mask separately excludes areas where measurement is less reliable. Neither establishes authenticity.</p>
{% for check in v.image_evidence.inspection_checks %}
<article class="image-inspection-check">
<h4>{{ check.label }} · {{ check.eligibility.title }}</h4>
{% if check.eligibility.score is not none %}<p class="caption">{% if check.eligibility.get('score_kind') == 'area_cells' %}Measured positions above the response cutoff <span class="mono">{{ check.eligibility.score }}</span> of <span class="mono">{{ check.eligibility.total_cells }}</span>. Minimum for showing candidates <span class="mono">{{ check.eligibility.threshold }}</span> positions.{% else %}Whole-image response <span class="mono">{{ check.eligibility.score }}</span> · display threshold <span class="mono">{{ check.eligibility.threshold }}</span>. This response is uncalibrated; it is not a region or pixel probability.{% endif %}</p>{% endif %}
<p class="caption">{{ check.eligibility.explanation }}</p>
{% if check.counts %}
<dl class="evidence-measurements">
<div><dt>Measured regions before image gate</dt><dd>{{ check.counts.raw }}</dd></div>
<div><dt>{{ check.eligible_count_label }}</dt><dd>{{ check.counts.eligible }}</dd></div>
<div><dt>Shown in these evidence cards</dt><dd>{{ check.counts.selected }}</dd></div>
<div><dt>{{ 'Supported regions not shown' if check.has_repeat else 'Eligible regions not shown' }}</dt><dd>{{ check.counts.omitted }}</dd></div>
</dl>
{% if check.counts.suppressed %}<p class="caption">{{ check.counts.suppressed }} measured region(s) were withheld by the image gate. The raw map remains in the evidence record; withheld regions are not cleared as authentic.</p>{% endif %}
{% if check.repeat %}
{% if check.jpeg_repeat %}
<p class="caption">The JPEG re-encoding check uses a second compression of the same upload and keeps an original region when at least half its measured cells recur. Agreement contributes no AI authorship weight.</p>
{% else %}
<p class="caption">The flip check uses the same detector on a horizontal flip. It retains a region when at least 50% of its measured grid cells overlap after mapping back. It contributes no AI authorship weight.</p>
{% endif %}
<p class="caption">The {{ check.repeat_label }} withheld {{ check.repeat.withheld }} of {{ check.repeat.inspected }} candidate regions.</p>
<ul class="caption">
{% for candidate in check.repeat.candidates %}
<li>Initial candidate {{ loop.index }}. {{ '{:,}'.format(candidate.shared_pixels) }} of {{ '{:,}'.format(candidate.source_pixels) }} measured cells overlapped. {{ 'Supported by the repeat.' if candidate.retained else 'Withheld after the repeat.' }}
<span class="mono">Source x {{ candidate.bounds[0] }}, y {{ candidate.bounds[1] }} · {{ candidate.bounds[2] }} × {{ candidate.bounds[3] }} px</span></li>
{% endfor %}
</ul>
{% if check.repeat.outside_limit %}<p class="caption">{{ check.repeat.outside_limit }} measured {{ 'region was' if check.repeat.outside_limit == 1 else 'regions were' }} outside the two-candidate review limit.</p>{% endif %}
{% elif check.has_repeat %}<p class="caption">Repeat-check coverage is unavailable.</p>{% endif %}
{% if check.counts.omitted %}<p class="caption">{{ check.counts.omitted }} {{ 'supported' if check.has_repeat else 'eligible' }} {{ 'region is' if check.counts.omitted == 1 else 'regions are' }} not shown because of display limits or evidence requirements. These cards are not an exhaustive map of possible edits.</p>{% endif %}
{% else %}<p class="caption">Region coverage counts are unavailable. Missing counts do not establish that no regions were measured.</p>{% endif %}
{% if check.map_grid %}<p class="caption">Measured grid {{ check.map_grid | join(' × ') }}. Displaying a larger image does not add detection detail.</p>{% endif %}
{% if check.excluded_percent is not none %}<p class="caption">{{ check.excluded_percent }}% of the measured grid was excluded as less reliable. Those areas were not cleared.</p>{% endif %}
{% if check.quality_reasons %}
<p class="caption">Image quality conditions by share of original pixels. The areas can overlap.</p>
<dl class="evidence-measurements">
{% for reason in check.quality_reasons %}<div><dt>{{ reason.label }}</dt><dd>{{ reason.percent }}%</dd></div>{% endfor %}
</dl>
{% endif %}
{% if check.get('coverage_map') %}
<figure class="inspection-coverage-map">
<img src="{{ check.coverage_map }}" alt="{{ check.label }} reliability mask on the measured image grid">
<figcaption class="caption">White marks cells that passed this check’s reliability filter. Black marks cells excluded from region selection.</figcaption>
</figure>
{% endif %}
{% if check.get('repeat_mask') %}
<figure class="inspection-coverage-map">
<img src="{{ check.repeat_mask }}" alt="{{ 'JPEG repeat mask' if check.jpeg_repeat else 'Horizontal repeat mask aligned to the submitted image' }}">
<figcaption class="caption">White marks cells selected in the repeated check after mapping back to the submitted image.</figcaption>
</figure>
{% endif %}
</article>
{% endfor %}
<p class="caption">This coverage lists checks with recorded maps. Skipped, failed or unavailable checks remain in the analysis check record; their absence here is not a negative finding.</p>
</div>
{% endif %}
{% for packet in v.image_evidence.packets %}
<article class="image-evidence-packet" id="image-evidence-{{ packet.id }}">
<h3>{{ packet.id }} · {{ packet.title }}</h3>
{% if packet.get('customer_inference') %}<p class="finding-inference"><strong>Inference:</strong> {{ packet.customer_inference }}</p>{% endif %}
<p class="caption">{% if packet.evidence_type == 'localisation' %}Localisation candidate{% else %}Inspection region{% endif %}{% if packet.finding_ids %} · Findings {{ packet.finding_ids | join(', ') }}{% endif %}{% if packet.signal_refs %} · Checks {% for ref in packet.signal_refs %}{{ ref.display_id }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
{% if not v.image_evidence.withheld %}
<div class="evidence-plates{% if packet.artifacts.get('copy_donor') %} evidence-plates-copy{% elif packet.images | length > 3 %} evidence-plates-four{% endif %}">
{% for image in packet.images %}
<figure>
<img src="{{ image.uri }}" alt="{{ packet.id }}: {{ image.label }}">
<figcaption>{{ image.label }}</figcaption>
</figure>
{% endfor %}
</div>
{% if packet.get('overlay_legend') %}<p class="caption">{{ packet.overlay_legend }}</p>{% endif %}
{% endif %}
<p class="evidence-position caption">Region: x {{ packet.region.x }}, y {{ packet.region.y }}, width {{ packet.region.w }}, height {{ packet.region.h }} px. Crop: x {{ packet.crop_region.x }}, y {{ packet.crop_region.y }}, width {{ packet.crop_region.w }}, height {{ packet.crop_region.h }} px.</p>
<p><strong>Observed:</strong> {{ packet.observation }}</p>
<p><strong>Interpretation:</strong> {{ packet.interpretation }}</p>
{% if packet.get('localisation') %}<p class="caption">Measured grid {{ packet.localisation.grid | join(' × ') }} · selected area {{ '%.2f' | format(packet.localisation.region_area_fraction * 100) }}%{% if not packet.localisation.get('jpeg_reencode_consistency') %} · operating threshold {{ packet.localisation.threshold }} (uncalibrated){% endif %}. White mask cells mark this selected region; black does not mean verified authentic.</p>{% endif %}
{% if packet.get('eligibility_view') %}
<div class="image-eligibility-note"><p class="caption"><strong>{{ packet.eligibility_view.title }}.</strong>{% if packet.eligibility_view.score is not none %}{% if packet.eligibility_view.get('score_kind') == 'area_cells' %} Measured positions above the response cutoff <span class="mono">{{ packet.eligibility_view.score }}</span> of <span class="mono">{{ packet.eligibility_view.total_cells }}</span>. Minimum for showing candidates <span class="mono">{{ packet.eligibility_view.threshold }}</span> positions.{% else %} Whole-image response <span class="mono">{{ packet.eligibility_view.score }}</span> · display threshold <span class="mono">{{ packet.eligibility_view.threshold }}</span>. This response is uncalibrated; it is not a region or pixel probability.{% endif %}{% endif %} {{ packet.eligibility_view.explanation }}</p></div>
{% endif %}
{% if packet.measurements %}<dl class="evidence-measurements">
{% for measure in packet.measurements %}<div><dt>{{ measure.label }}</dt><dd>{{ measure.value }}{% if measure.unit %} {{ measure.unit }}{% endif %}</dd></div>{% endfor %}
</dl>{% endif %}
{% if packet.limitations %}<p class="evidence-limits"><strong>Limits:</strong> {{ packet.limitations | join(' ') }}</p>{% endif %}
<p class="caption evidence-asset-hashes">{% for image in packet.images %}{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
</article>
{% else %}
<p>{% if (translation and translation.pairs) or (exact_pair and exact_pair.pair) or (native_interpolation and native_interpolation.record.region) or (jpeg_grid and jpeg_grid.record.region) %}No other local editing regions were recorded.{% elif v.image_evidence.get('inspection_checks') %}No local editing candidates are shown. The coverage above explains what was measured and withheld.{% else %}No separate local editing regions were recorded.{% endif %} An overall classification does not identify altered pixels. This does not establish that the image is unaltered.</p>
{% endfor %}
{% if v.image_evidence.omitted_regions %}<p class="caption">{{ v.image_evidence.omitted_regions }} additional candidate regions were omitted from this bounded evidence set.</p>{% endif %}
{% for note in v.image_evidence.limitations %}<p class="caption">{{ note }}</p>{% endfor %}
{% endif %}
</section>
{% endif %}
