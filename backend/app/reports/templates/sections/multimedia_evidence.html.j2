{% if v.get('evidence') and not v.evidence.available %}<p class="caption evidence-unavailable">{{ v.evidence.note }}</p>{% endif %}
{% if v.get('evidence') and v.evidence.available %}
{% set evidence = v.evidence %}
{% macro plates(images, wide=false, support=none) %}
{% if images and not evidence.withheld %}
<div class="multimedia-plates{% if wide %} multimedia-wide{% endif %}{% if support %} multimedia-picture-support{% endif %}">
{% for image in images %}<figure{% if image.get('anchor') %} id="{{ image.anchor }}"{% endif %}><img src="{{ image.uri }}" alt="{{ image.label }}"><figcaption>{{ image.label }}</figcaption></figure>{% endfor %}
{% if support %}
<figure><div class="multimedia-support-frame">
<img src="{{ images[0].uri }}" alt="Source frame with picture-change support tiles">
<svg viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
{% for tile in support %}
{% set x = (tile % 10) * 10 %}{% set y = (tile // 10) * 10 %}
<rect x="{{ x }}" y="{{ y }}" width="10" height="10" fill="#f6ca62" fill-opacity="0.15" stroke="#172923" stroke-width="0.65"/>
<rect x="{{ x }}" y="{{ y }}" width="10" height="10" fill="none" stroke="#f6ca62" stroke-width="0.28"/>
{% endfor %}
</svg>
</div><figcaption>The {{ support | length }} outlined tiles show texture measurements that support the start and end times. Ordinary cuts can produce this pattern.</figcaption></figure>
{% endif %}
</div>
{% endif %}
{% endmacro %}
{% macro related_voice(ids) %}
{% if ids %}<p class="caption">Overlapping voice-check intervals {% for id in ids %}<a href="#multimedia-evidence-{{ id }}">{{ id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}. Listen to the overlapping intervals for context.</p>{% endif %}
{% endmacro %}
<section class="{% if evidence.packets or evidence.overview or evidence.acoustic_contexts or evidence.get('repetition_context') or evidence.get('stereo_repetition') or evidence.get('similarity_context') or evidence.get('repeated_passages') %}chapter{% else %}chapter-cont{% endif %} multimedia-evidence{% if s.report.profile in ['summary', 'newsroom'] and evidence.packets %} evidence-appendix{% endif %}" aria-labelledby="multimedia-evidence-heading">
<h2 class="chapter-title" id="multimedia-evidence-heading">{% if v.get('number', {}).get('source-evidence') %}<span class="n">{{ v.number['source-evidence'] }}</span>{% endif %}{{ evidence.title }}</h2>
<p>{{ evidence.note }}</p>
{% if evidence.available %}
<p class="caption">Evidence set {{ evidence.version }} - SHA-256 <span class="mono evidence-hash">{{ evidence.sha256 }}</span></p>
<p class="caption"{% if evidence.kind == 'audio' %} id="multimedia-evidence-voice-coverage"{% endif %}>{{ evidence.coverage_note }}</p>
{% for note in evidence.coverage_details %}<p class="caption">{{ note }}</p>{% endfor %}
{% set invisible = evidence.get('invisible_characters') %}
{% if invisible %}
<h3 id="document-invisible-characters">{{ invisible.title }}</h3>
<p>Checked {{ invisible.checked_chars }} extracted characters across {{ invisible.checked_blocks }} mapped blocks. Found {{ invisible.matches }} marked {{ 'character' if invisible.matches == 1 else 'characters' }}.</p>
{% if invisible.locations %}
<table class="multimedia-locator" aria-labelledby="document-invisible-characters">
<colgroup><col style="width: 23%"><col style="width: 60%"><col style="width: 17%"></colgroup>
<thead><tr><th>Character</th><th>Source location</th><th>Extracted offset</th></tr></thead>
<tbody>{% for row in invisible.locations %}
<tr><td><span class="mono" style="white-space: nowrap">{{ row.codepoint }}</span><br>{{ row.name }}</td><td>{{ row.label }} [{{ row.source_start }}, {{ row.source_end }})</td><td>{{ row.text_offset }}</td></tr>
{% endfor %}</tbody></table>
<p class="caption">Positions are zero-based. End offsets are exclusive.</p>
{% endif %}
{% if invisible.matches > invisible.locations | length %}<p class="caption">{{ invisible.matches - (invisible.locations | length) }} further characters exceed the location display limit.</p>{% endif %}
<p class="caption">{{ invisible.scope }} {{ invisible.limitation }} JSON pointer <span class="mono">/coverage/invisible_characters</span>.</p>
{% endif %}
{% set timing = evidence.get('av_timing_windows') %}
{% if timing %}
<h3 id="multimedia-av-timing-coverage">Speech and mouth timing coverage</h3>
<p>{{ timing.measured }} of {{ timing.total }} scheduled one-second windows reached a timing measurement. These overlapping windows are scheduled within the decoded soundtrack. A measurement can still yield an inconclusive timing result.</p>
{% if timing.unmeasured %}
<table class="multimedia-locator">
<thead><tr><th>Original video time</th><th>Why timing was unassessed</th></tr></thead>
<tbody>{% for window in timing.unmeasured %}
<tr><td>{{ window.start_s }}–{{ window.end_s }} s</td><td>{{ window.reason }}</td></tr>
{% endfor %}</tbody>
</table>
{% endif %}
{% if timing.unlisted %}<p class="caption">{{ timing.unlisted }} more unassessed windows are listed in the JSON.</p>{% endif %}
<p class="caption">JSON pointer <span class="mono">/av/coverage/timing_windows</span>.</p>
{% endif %}
{% set quantities = evidence.get('percentage_consistency') %}
{% if quantities %}
<h3 id="document-percentage-consistency">Repeated percentage statements</h3>
<p>{{ quantities.scope }}</p>
{% if quantities.groups %}
<p>{{ quantities.different_claims }} repeated {% if quantities.different_claims == 1 %}statement uses{% else %}statements use{% endif %} different values.</p>
{% for group in quantities.groups %}
{% for row in group %}
{% if not evidence.withheld %}<blockquote>{{ row.before }}<mark>{{ row.quantity }}</mark>{{ row.after }}</blockquote>{% endif %}
<p class="caption">{% if row.anchor is defined %}{% if row.anchor.kind == 'pdf' %}PDF page {{ row.anchor.page }} · {% elif row.anchor.kind == 'docx' %}Word body paragraph {{ row.anchor.body_paragraph }} · {% elif row.anchor.kind == 'email' %}Email body part {{ row.anchor.mime_part }} · {% endif %}{% endif %}Statement [{{ row.start }}, {{ row.end }}) · Value [{{ row.quantity_start }}, {{ row.quantity_end }})</p>
{% if row.value_location is defined and row.value_location.ranges is defined %}
<p class="caption">Original value position {% for start, end in row.value_location.ranges %}[{{ start }}, {{ end }}){% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif %}
{% endfor %}
{% endfor %}
{% if quantities.different_claims > (quantities.groups | length) %}<p class="caption">{{ quantities.different_claims - (quantities.groups | length) }} additional statements exceed the display limit.</p>{% endif %}
{% elif quantities.status == 'checked' %}<p>No differently stated values were found in the eligible repeated sentences.</p>
{% else %}<p>No eligible percentage statement was repeated across separate paragraphs.</p>{% endif %}
<p class="caption">{{ quantities.limitation }} Positions use extracted Unicode characters. JSON pointer <span class="mono">/percentage_consistency</span>.</p>
{% endif %}
{% set email_scope = evidence.get('email_classifier_input_scope') %}
{% if email_scope %}
<h3 id="multimedia-email-input-scope">What the email writing checks read</h3>
<p class="caption">Selected MIME part {{ email_scope.mime_part }}. Counts cover retained complete classifier inputs. Each input can contain several sentences.</p>
{% if email_scope.mapping == 'unmapped' %}<p>The source mapping could not separate message text, quotes and signatures.</p>{% endif %}
{% if email_scope.checks %}
<table class="multimedia-locator">
<thead><tr><th>Check</th><th>Message only</th><th>Quote only</th><th>Signature only</th><th>Mixed roles</th><th>Role unavailable</th><th>Unlisted</th></tr></thead>
<tbody>{% for row in email_scope.checks %}
<tr><td>{{ row.signal_ref.display_id }}</td><td>{{ row.counts.body }}</td><td>{{ row.counts.quoted }}</td><td>{{ row.counts.signature }}</td><td>{{ row.counts.mixed }}</td><td>{{ row.counts.unmapped }}</td><td>{{ row.unlisted }}</td></tr>
{% endfor %}</tbody></table>
{% else %}<p>No complete local classifier inputs were retained for this email.</p>{% endif %}
<p class="caption">Roles come from the decoded message structure. Unlisted inputs exceed the display bounds or lack complete token records. These counts describe coverage. JSON pointer <span class="mono">/coverage/email_classifier_input_scope</span>.</p>
{% endif %}
{% set review = evidence.get('email_body_alternatives') %}
{% if review %}
<h3 id="multimedia-email-body-alternatives">Email body rendition comparison</h3>
<p>{% if review.status == 'difference' %}Some wording differs between the plain-text and HTML bodies. Ordinary email formatting and different versions of a message can produce these differences.{% elif review.status == 'equivalent' %}No material difference in the text checked.{% else %}The email body renditions could not be compared within the supported scope.{% endif %}</p>
<p class="caption">This comparison covers text only and carries zero AI confidence weight. JSON pointer <span class="mono">/coverage/email_body_alternatives</span>.</p>
{% for change in review.get('differences', []) %}
<h4>{{ change.id }} · Wording difference</h4>
{% for side in ['plain', 'html'] %}
{% if change.get(side) %}<p><strong>{{ 'Plain-text body' if side == 'plain' else 'HTML body text' }}.</strong>{% if not evidence.withheld %} {{ change[side].text }}{% endif %}</p>
<p class="caption">MIME part {{ review.parts[side].id }} · decoded characters {% for range in change[side].source_ranges %}[{{ range[0] }}, {{ range[1] }}){% if not loop.last %}, {% endif %}{% endfor %}.{% if change[side].excerpt_truncated %} Excerpt shortened.{% endif %}</p>
{% endif %}
{% endfor %}
{% endfor %}
{% if review.get('omitted_differences', 0) %}<p class="caption">{{ review.omitted_differences }} further differences exceed the excerpt display limit.</p>{% endif %}
{% endif %}
{% if evidence.get('brief_face_review') %}
<h3 id="multimedia-brief-face-review">Brief face-change check</h3>
{% for observation in evidence.brief_face_review.observations %}<p class="caption">{{ observation }}</p>{% endfor %}
<p class="caption">This check carries zero AI confidence weight. JSON pointer <span class="mono">/coverage/brief_face_review</span>.</p>
{% endif %}
{% if evidence.get('brief_face_windows') %}
<h3>Overlapping face-change windows</h3>
{% for observation in evidence.brief_face_windows.observations %}<p class="caption">{{ observation }}</p>{% endfor %}
<p class="caption">This check carries zero AI confidence weight. JSON pointer <span class="mono">/coverage/brief_face_windows</span>.</p>
{% endif %}
{% if evidence.get('scene_return_review') %}
{% set review = evidence.scene_return_review %}
<h3>Picture-change coverage</h3>
<p class="caption">{{ review.observation }}{% if review.packet_id %} See evidence {{ review.packet_id }} for the three source frames.{% endif %}</p>
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/coverage/scene_return_review</span>.</p>
{% endif %}
{% if evidence.get('short_voice_review') %}
{% set review = evidence.short_voice_review %}
<h3 id="multimedia-short-voice-review">{{ review.title }}</h3>
<p class="caption">{% if review.status == 'skipped' %}Skipped. {% endif %}{{ review.reason }}</p>
{% if review.status == 'flagged' %}
<p class="caption">Flagged window {{ '%.3f' | format(review.start_s) }}–{{ '%.3f' | format(review.end_s) }} s.
Samples [{{ review.interval.start_sample }}, {{ review.interval.end_sample }}) at 16000 Hz.
{% for range in review.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if review.get('recording_context') %}<p class="caption">Overlapping recording observations {% for id in review.recording_context %}<a href="#multimedia-evidence-{{ id }}">{{ id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}. They describe the same time in the mixed track. The cause of the speech response is undetermined.</p>{% endif %}
{% if review.get('waveform') %}{{ plates([review.waveform]) }}{% endif %}
{% endif %}
{% if review.get('window_coverage') %}
<h4>Two-second window coverage</h4>
<p class="caption">Each window requires at least one second of detected speech in the mixed track.</p>
<table class="grid">
<thead><tr><th>Analyzed window</th><th>Detected speech</th><th>Coverage</th><th>Source PTS at 1/16000</th></tr></thead>
<tbody>{% for window in review.window_coverage %}
{% set source_range = window.source_timestamp_ranges[0] %}
<tr><td>{{ '%.3f' | format(window.start_sample / 16000) }}–{{ '%.3f' | format(window.end_sample / 16000) }} s</td>
<td>{{ '%.3f' | format(window.speech_samples / 16000) }} s</td>
<td>{{ 'Checked' if window.status == 'checked' else 'Below the speech minimum' }}</td>
<td class="mono">[{{ source_range.source_start_pts }}, {{ source_range.source_end_pts }})</td></tr>
{% endfor %}</tbody>
</table>
{% endif %}
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/short_voice_review</span>.</p>
{% endif %}
{% if evidence.get('long_voice_review') %}
{% set review = evidence.long_voice_review %}
<h3 id="multimedia-long-voice-review">{{ review.title }}</h3>
<p class="caption">{% if review.status == 'skipped' %}Skipped. {% endif %}{{ review.reason }}</p>
{% for region in review.get('regions', []) %}
<p class="caption"><strong>{% if region.basis == 'overlap' %}Overlap of two AI-leaning windows{% else %}Corroborated three-second window{% endif %}</strong>.
{{ '%.3f' | format(region.start_sample / 16000) }}–{{ '%.3f' | format(region.end_sample / 16000) }} s.
Samples [{{ region.start_sample }}, {{ region.end_sample }}) at 16000 Hz.
{% for range in region.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if region.get('waveform') %}{{ plates([region.waveform]) }}{% endif %}
{% endfor %}
{% for window in review.windows %}
<p class="caption"><strong>{{ window.label }}</strong>. {{ '%.3f' | format(window.start_sample / 16000) }}–{{ '%.3f' | format(window.end_sample / 16000) }} s.
Samples [{{ window.start_sample }}, {{ window.end_sample }}) at 16000 Hz.
{% for range in window.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if window.get('waveform') %}{{ plates([window.waveform]) }}{% endif %}
{% endfor %}
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/long_voice_review</span>.</p>
{% endif %}
{% if evidence.get('background_reduced_voice_review') %}
{% set review = evidence.background_reduced_voice_review %}
<h3 id="multimedia-background-reduced-voice-review">{{ review.title }}</h3>
<p class="caption">{{ review.reason }}</p>
{% if review.status == 'flagged' %}
<p class="caption">Loud background sound can make genuine speech look AI-generated in this check. When voices overlap, the check cannot identify which speaker drove the result.</p>
<p class="caption">Flagged interval 0.000–3.000 s. Samples [{{ review.interval.start_sample }}, {{ review.interval.end_sample }}) at 16000 Hz.
{% for range in review.source_timestamp_ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% endfor %}</p>
{% if not evidence.withheld %}<p class="caption">The evidence export includes original and background-reduced playback of this interval.</p>{% endif %}
{% if review.get('waveform') %}{{ plates([review.waveform]) }}{% endif %}
{% endif %}
<p class="caption">{{ review.limitation }} JSON pointer <span class="mono">/background_reduced_voice_review</span>.</p>
{% endif %}
{% if evidence.get('passage_coverage') %}
{% set writing = evidence.passage_coverage %}
<h3>Recorded passage coverage</h3>
<p class="caption">Counts describe the {{ writing.mapped_characters }} extracted characters excluding whitespace. A local response applies to its input window. Context-only text was read as part of another response.</p>
{% if writing.includes_sentence_positions %}<p class="caption">Counts include completed sentence-position readings.</p>{% endif %}
<p class="caption">{% for label, amount in writing.counts %}{{ label }}: {{ amount }}. {% endfor %}</p>
{% if writing.ranges %}
<table class="multimedia-locator"><thead><tr><th>Source</th><th>Extracted character range</th><th>Local coverage</th></tr></thead><tbody>
{% for row in writing.ranges %}
<tr><td>{% if row.get('page') %}Page {{ row.page }}{% elif row.get('paragraph') %}Paragraph {{ row.paragraph }}{% else %}Source block {{ row.source_block }}{% endif %}{% if row.get('mime_part') %} · Email part {{ row.mime_part }}{% endif %}{% if row.get('quote_role') %} · {{ row.quote_role }}{% endif %}</td><td>[{{ row.start }}, {{ row.end }})</td><td>{{ row.label }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}
<p class="caption">Ranges use extracted Unicode characters and exclude the end position. {% if writing.additional_ranges %}{{ writing.additional_ranges }} more retained ranges appear in the JSON report. {% endif %}{% if writing.omitted_ranges %}The counts include {{ writing.omitted_ranges }} additional ranges beyond the retained list. {% endif %}JSON pointer <span class="mono">/coverage/local_passage_coverage</span>.</p>
{% if writing.pdf_pages %}
{% set page_coverage = writing.pdf_pages %}
<h3>Text coverage by PDF page</h3>
<p class="caption">The source contains {{ page_coverage.page_count }} {% if page_coverage.page_count == 1 %}page{% else %}pages{% endif %}. Counts exclude whitespace and cover mapped text. Unmapped text and unchecked image areas have no local result.</p>
<table class="multimedia-locator"><thead><tr><th>PDF page</th><th>Extraction</th><th>Local response</th><th>Context only</th><th>No local record</th></tr></thead><tbody>
{% for row in page_coverage.rows %}
<tr><td>{% if row.start == row.end %}Page {{ row.start }}{% else %}Pages {{ row.start }}–{{ row.end }}{% endif %}</td>
<td>{{ row.label }}{% if row.get('partial') %}. Unchecked image areas{% endif %}</td>
{% if row.counts %}<td>{{ row.counts.response_range }}</td><td>{{ row.counts.context_only }}</td><td>{{ row.counts.no_local_record }}</td>
{% else %}<td>—</td><td>—</td><td>—</td>{% endif %}</tr>
{% endfor %}
</tbody></table>
<p class="caption">{% if page_coverage.additional_rows %}{{ page_coverage.additional_rows }} more rows appear in the JSON report. {% endif %}JSON pointer <span class="mono">/coverage/local_passage_coverage/pdf_pages</span>.</p>
{% endif %}
{% endif %}
{% if evidence.get('word_tracked_changes') %}
{% set tracked = evidence.word_tracked_changes %}
<h3>Word tracked text changes</h3>
<p class="caption">{{ tracked.scope }} {{ tracked.limitation }}</p>
<p class="caption">Checked {{ tracked.paragraphs }} body paragraphs. Found {{ tracked.inserted }} insertions and {{ tracked.deleted }} deletions.
{% if tracked.unsupported_marks %}{{ tracked.unsupported_marks }} additional revision marks were outside scope.{% endif %}
{% if tracked.omitted_excerpts %}{{ tracked.omitted_excerpts }} further excerpts exceed the display limit.{% endif %}</p>
{% for row in tracked.rows %}
<p class="caption"><strong>{{ row.kind | capitalize }} · Body paragraph {{ row.paragraph }}</strong>.
XML body index {{ row.body_index }}, paragraph child index {{ row.inline_index }} (zero-based).</p>
<blockquote>{{ row.text }}{% if row.characters > row.text | length %}… ({{ row.characters }} source characters){% endif %}</blockquote>
{% endfor %}
<p class="caption">Source part <span class="mono">{{ tracked.part }}</span>. JSON pointer <span class="mono">/coverage/word_tracked_changes</span>.</p>
{% endif %}
{% if evidence.get('unselected_writing_responses') %}
{% include 'sections/document_unselected_responses.html.j2' %}
{% endif %}
{% if evidence.get('passage_position') %}
{% include 'sections/document_passage_position.html.j2' %}
{% endif %}
{% if evidence.get('writing_agreement') %}
<h3>Second writing check</h3>
<p class="caption">The second check revisits the exact text behind up to six AI-like responses. This evidence carries zero weight in the overall assessment.</p>
{% if evidence.writing_agreement.email_reply_body %}<p class="caption">This check covers contexts wholly inside the reply body. Text marked as a quote or signature and contexts that cross those boundaries are outside this check.</p>{% endif %}
{% if evidence.writing_agreement.mapped_html_body %}<p class="caption">The JSON includes exact positions in the decoded HTML body of the selected email part.</p>{% endif %}
{% if evidence.writing_agreement.selectable_pdf_pages %}<p class="caption">The second check uses selectable text on PDF {{ 'page' if evidence.writing_agreement.selectable_pdf_pages | length == 1 else 'pages' }} {{ evidence.writing_agreement.selectable_pdf_pages | join(', ') }}. It leaves OCR, partially checked pages, and contexts crossing pages outside this check.</p>{% endif %}
{% if evidence.writing_agreement.ranges %}
<table class="multimedia-locator"><thead><tr><th>Passage focus</th><th>First-check context</th><th>Second check</th></tr></thead><tbody>
{% for row in evidence.writing_agreement.ranges %}
<tr><td>{% if row.page %}Page {{ row.page }} · {% endif %}[{{ row.start }}, {{ row.end }})</td><td>{% for span in row.spans %}[{{ span.start }}, {{ span.end }}){% if not loop.last %}, {% endif %}{% endfor %}</td><td>{{ row.label }}</td></tr>
{% endfor %}
</tbody></table>
<p class="caption">Ranges use extracted Unicode characters. JSON pointer <span class="mono">/coverage/writing_second_check</span>.</p>
{% else %}<p class="caption">The first check supplied no AI-like contexts for this review.</p>{% endif %}
{% endif %}
{% if evidence.get('audio_tracks') %}
<div class="multimedia-acoustic-summary">
<h3>Audio track coverage</h3>
{% set count = evidence.audio_tracks | length %}
<p>The file contains {{ count }} audio tracks. Audio checks used the first track (source stream index {{ evidence.audio_tracks[0] }}). {% if count == 2 %}The second track was unassessed.{% else %}The other {{ count - 1 }} tracks were unassessed.{% endif %}</p>
<p class="caption">The track list is recorded at JSON pointer <span class="mono">{{ evidence.audio_tracks_pointer }}</span>.</p>
</div>
{% endif %}
{% if evidence.get('audio_source_clock') %}
{% set clock = evidence.audio_source_clock %}
{% set rate = evidence.audio_source_clock_rate %}
<h3>Audio source clock breaks</h3>
{% if clock.get('recording_voice_estimate_withheld') %}
<p>The source audio timestamps contain a gap or overlap. Voice checks use only continuous intervals, so the report gives no recording-wide voice estimate.</p>
{% endif %}
{% if clock.total_discontinuities %}
<p class="caption">The decoded listening copy joins these source spans. {{ clock.scored_windows_crossing }} recorded voice {{ 'window crosses' if clock.scored_windows_crossing == 1 else 'windows cross' }} a source clock break. This timing check carries zero weight in the AI assessment.</p>
{% for item in clock.breaks %}
<p class="caption">At {{ '%.3f' | format(item.boundary_sample / rate) }} s of analyzed audio. Source timestamp {{ 'gap' if item.jump_samples > 0 else 'overlap' }} of {{ '%.3f' | format((item.jump_samples | abs) * 1000 / rate) }} ms.
On the original timeline, the audio spans {{ '%.3f' | format(item.before.source_start_pts / rate) }} s to {{ '%.3f' | format(item.before.source_end_pts / rate) }} s before the break and {{ '%.3f' | format(item.after.source_start_pts / rate) }} s to {{ '%.3f' | format(item.after.source_end_pts / rate) }} s after it.
{{ item.scored_windows_crossing }} recorded voice {{ 'window crosses' if item.scored_windows_crossing == 1 else 'windows cross' }} this break.</p>
{% endfor %}
<p class="caption">This check lists jumps of at least {{ '%.0f' | format(clock.minimum_jump_samples * 1000 / rate) }} ms. {% if clock.total_discontinuities > clock.breaks | length %}Showing the {{ clock.breaks | length }} largest of {{ clock.total_discontinuities }} breaks. The full source timeline is in JSON.{% endif %}</p>
{% else %}
<p class="caption">No source clock break of at least {{ '%.0f' | format(clock.minimum_jump_samples * 1000 / rate) }} ms was measured in {{ '%.3f' | format(clock.checked_samples / rate) }} s of decoded audio. This timing check carries zero weight in the AI assessment.</p>
{% endif %}
<p class="caption">JSON pointer <span class="mono">{{ evidence.audio_source_clock_pointer }}</span>.</p>
{% endif %}
{% if evidence.get('speech_window_selection') %}
{% set selection = evidence.speech_window_selection %}
<h3>How speech windows were selected</h3>
<p class="caption">{{ selection.counts.scored }} scored. {{ selection.counts.below_speech_minimum }} below the speech minimum. {{ selection.counts.outside_window_limit }} outside the window limit.</p>
<p class="caption">The voice check requires detected speech in at least half of each candidate window. These measurements describe speech coverage in the mixed track and carry zero weight in the AI estimate.</p>
{% for window in evidence.speech_windows %}
<p class="caption">Analyzed audio {{ '%.3f' | format(window.start_s) }}–{{ '%.3f' | format(window.end_s) }} s. Detected speech {{ '%.1f' | format(window.speech_percent) }}%. {{ 'Below the speech minimum.' if window.status == 'below_speech_minimum' else 'Outside the window limit.' }}
{% for range in window.ranges %}Source PTS [{{ range.source_start_pts }}, {{ range.source_end_pts }}) at {{ range.time_base }}.{% if range.playback %} Video playback {{ '%.3f' | format(range.playback[0]) }}–{{ '%.3f' | format(range.playback[1]) }} s.{% endif %}{% endfor %}</p>
{% endfor %}
<p class="caption">All measured windows and source timestamps are recorded in JSON at <span class="mono">{{ evidence.speech_selection_pointer }}</span>.</p>
{% endif %}
{% if evidence.get('voice_gaps') %}
<h3>Unscored voice intervals</h3>
<p class="caption">These times have no recorded voice response. Background sound can affect coverage, and the gap alone does not establish its cause.</p>
{% for gap in evidence.voice_gaps %}
<p class="caption">Analyzed audio {{ '%.3f' | format(gap.start_s) }}–{{ '%.3f' | format(gap.end_s) }} s.
