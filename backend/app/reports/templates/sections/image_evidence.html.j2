{% if v.get('image_evidence') and not v.image_evidence.available %}<p class="caption evidence-unavailable">{{ v.image_evidence.note }}</p>{% endif %}
{% if v.get('image_evidence') and v.image_evidence.available %}
{% set similarity = v.image_evidence.get('copy_similarity') %}
{% set translation = v.image_evidence.get('copy_translation') %}
{% set affine = v.image_evidence.get('copy_affine') %}
{% set exact_pair = v.image_evidence.get('embedded_pair_difference') %}
{% set evidence_detail = v.image_evidence.packets or v.image_evidence.get('inspection_checks') or (similarity and similarity.pairs) or (translation and translation.pairs) or (affine and affine.pairs) or (exact_pair and exact_pair.pair) %}
<section class="{% if evidence_detail %}chapter{% else %}chapter-cont{% endif %} image-evidence{% if s.report.profile in ['summary', 'newsroom'] and evidence_detail %} evidence-appendix{% endif %}" aria-labelledby="image-evidence-heading">
<h2 class="chapter-title" id="image-evidence-heading">{% if v.get('number', {}).get('source-evidence') %}<span class="n">{{ v.number['source-evidence'] }}</span>{% endif %}Image evidence</h2>
<p>{{ v.image_evidence.note }}</p>
{% if v.image_evidence.available %}
<p class="caption">Evidence set {{ v.image_evidence.version }} · <span class="mono">{{ v.image_evidence.sha256 }}</span></p>
<p class="caption">Coordinates are in the EXIF-oriented original, {{ v.image_evidence.source.width }} × {{ v.image_evidence.source.height }} pixels.</p>
{% if v.image_evidence.withheld %}<p class="caption">Source images and crops are withheld in this redacted copy. The evidence references and observations remain available.</p>{% endif %}
{% if similarity and similarity.status == 'skipped_trusted_ai_credentials' %}
<p>{{ similarity.observation }}</p>
{% else %}
{% for check, title, label in [(similarity, 'Same-image copy similarity', 'Reflected pair'), (translation, 'Copy similarity without mirroring', 'Non-mirrored pair'), (affine, 'Geometric copy comparison', 'Matched source areas')] if check %}
<div class="image-regional-comparison">
<h3>{{ title }}</h3>
<p>{{ check.observation }}</p>
<p class="caption">{{ check.interpretation }}</p>
{% if check.schema in ['same-image-copy-similarity/1', 'same-image-affine-support/1', 'same-image-affine-support/2'] %}<p class="caption">This check carries zero weight in AI authorship confidence.</p>{% endif %}
{% if check.get('proposal_search') and check.proposal_search.basis == 'reduced' %}<p class="caption">The candidate search used a {{ check.proposal_search.width }} × {{ check.proposal_search.height }} pixel working image. The check measured any matching masks on the original pixel grid.</p>{% endif %}
{% if check.get('basis_text') %}<p class="caption">{{ check.basis_text }}</p>{% endif %}
{% for pair in check.pairs %}
<article class="image-evidence-packet" id="image-evidence-{{ pair.id }}">
<h4>{{ pair.id }} · {{ label }}</h4>
{% if pair.get('selected_pixels') %}<p class="caption">White shows the selected comparison area. Area A contains {{ pair.selected_pixels.area_a }} selected pixels. Its projection onto Area B covers {{ pair.selected_pixels.area_b }} pixels.</p>{% endif %}
<div class="evidence-plates {% if pair.get('selected_pixels') %}evidence-plates-four{% else %}evidence-plates-pair{% endif %}">
{% for image in pair.images %}
{% set region = pair.regions[image.role] %}
<figure>
{% if image.uri %}<img src="{{ image.uri }}" alt="{{ image.label }}">{% endif %}
<figcaption>{{ image.label }} · x {{ region.x }}, y {{ region.y }}, {{ region.w }} × {{ region.h }} px</figcaption>
</figure>
{% endfor %}
</div>
{% for image in pair.images %}<p class="caption evidence-asset-hashes">{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span></p>{% endfor %}
</article>
{% endfor %}
</div>
{% endfor %}
{% endif %}
{% if exact_pair and exact_pair.status != 'skipped_trusted_ai_credentials' %}
<div class="image-regional-comparison">
<h3>Pixel differences between matching areas</h3>
<p>{{ exact_pair.observation }}</p>
{% if exact_pair.pair %}
{% set pair = exact_pair.pair %}
<p class="caption">{{ exact_pair.interpretation }}</p>
<article class="image-evidence-packet" id="image-evidence-{{ pair.id }}">
<h4>{{ pair.id }} · {{ pair.different_pixels }} differing pixels in each area</h4>
<div class="evidence-plates evidence-plates-four evidence-plates-pair">
{% for image in pair.images if image.role != 'difference_mask' %}
{% set region = pair.regions.area_a if image.role in ['area_a', 'overlay_a'] else pair.regions.area_b %}
<figure>{% if image.uri %}<img src="{{ image.uri }}" alt="{{ image.label }}">{% endif %}
<figcaption>{{ image.label }} · x {{ region.x }}, y {{ region.y }}, {{ region.w }} × {{ region.h }} px</figcaption></figure>
{% endfor %}
</div>
{% for label, region in [('Area A', pair.difference_regions.area_a), ('Area B', pair.difference_regions.area_b)] %}
<p class="caption">{{ label }} difference bounds x {{ region.x }}, y {{ region.y }}, {{ region.w }} × {{ region.h }} px.</p>
{% endfor %}
{% for image in pair.images %}<p class="caption evidence-asset-hashes">{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span></p>{% endfor %}
</article>
{% endif %}
</div>
{% endif %}
{% if v.image_evidence.get('comparison') %}
{% set comparison = v.image_evidence.comparison %}
<div class="image-regional-comparison">
<h3>Compare local editing cues</h3>
<p>{{ comparison.interpretation }}</p>
{% if comparison.status == 'unavailable' %}<p>A shared regional view is unavailable for this result. This does not establish that the image is unaltered.</p>
{% else %}
{% if comparison.status != 'ready' %}<p class="caption">Some eligible regions are not shown. This comparison covers the retained evidence cards only.</p>{% endif %}
{% if not v.image_evidence.withheld %}
<div class="evidence-plates evidence-plates-four">
{% for image in comparison.images %}<figure><img src="{{ image.uri }}" alt="{{ image.label }}"><figcaption>{{ image.label }}</figcaption></figure>{% endfor %}
</div>
<p class="caption">Orange marks cells selected by either check; purple marks cells selected by both. White mask cells are selected; black cells are not verified original. A single shared cell is retained.</p>
{% endif %}
<p class="caption">Wider view: {{ comparison.counts.wider }} measured cells. Shared view: {{ comparison.counts.shared }} measured cells. Measured grid {{ comparison.map_grid | join(' × ') }}. Larger previews do not add pixel detail.{% if comparison.counts.shared == 0 %} No shared cells were selected; disagreement does not clear the file.{% endif %}</p>
{% endif %}
{% for member in comparison.members %}<p class="caption">{{ member.label }}: {{ {'measured': 'Measured', 'withheld': 'Candidate regions withheld', 'missing': 'Not available', 'failed': 'Check failed', 'skipped': 'Check skipped', 'unavailable': 'Evidence unavailable'}[member.status] }}.{% if member.packet_ids %} Retained regions: {% for id in member.packet_ids %}<a href="#image-evidence-{{ id }}">{{ id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>{% endfor %}
{% for note in comparison.limitations %}<p class="caption">{{ note }}</p>{% endfor %}
{% for image in comparison.images %}<p class="caption evidence-asset-hashes">{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span></p>{% endfor %}
</div>
{% endif %}
{% if v.image_evidence.get('inspection_checks') %}
<div class="image-inspection-checks">
<h3>How inspection regions were selected</h3>
<p class="caption">The image gate controls candidate display. The reliability mask separately excludes areas where measurement is less reliable. Neither establishes authenticity.</p>
{% for check in v.image_evidence.inspection_checks %}
<article class="image-inspection-check">
<h4>{{ check.label }} · {{ check.eligibility.title }}</h4>
{% if check.eligibility.score is not none %}<p class="caption">{% if check.eligibility.get('score_kind') == 'area_cells' %}Active screening cells <span class="mono">{{ check.eligibility.score }}</span> · minimum <span class="mono">{{ check.eligibility.threshold }}</span>.{% else %}Whole-image response <span class="mono">{{ check.eligibility.score }}</span> · display threshold <span class="mono">{{ check.eligibility.threshold }}</span>. This response is uncalibrated; it is not a region or pixel probability.{% endif %}</p>{% endif %}
<p class="caption">{{ check.eligibility.explanation }}</p>
{% if check.counts %}
<dl class="evidence-measurements">
<div><dt>Measured regions before image gate</dt><dd>{{ check.counts.raw }}</dd></div>
<div><dt>{{ check.eligible_count_label }}</dt><dd>{{ check.counts.eligible }}</dd></div>
<div><dt>Shown in these evidence cards</dt><dd>{{ check.counts.selected }}</dd></div>
<div><dt>{{ 'Supported regions not shown' if check.has_flip else 'Eligible regions not shown' }}</dt><dd>{{ check.counts.omitted }}</dd></div>
</dl>
{% if check.counts.suppressed %}<p class="caption">{{ check.counts.suppressed }} measured region(s) were withheld by the image gate. The raw map remains in the evidence record; withheld regions are not cleared as authentic.</p>{% endif %}
{% if check.flip %}
<p class="caption">The flip check uses the same detector on a horizontal flip. It retains a region when at least 50% of its source pixels overlap after mapping back. It contributes no AI authorship weight.</p>
<p class="caption">The flip check withheld {{ check.flip.withheld }} of {{ check.flip.inspected }} candidate regions.</p>
{% if check.flip.outside_limit %}<p class="caption">{{ check.flip.outside_limit }} measured {{ 'region was' if check.flip.outside_limit == 1 else 'regions were' }} outside the two-candidate review limit.</p>{% endif %}
{% elif check.has_flip %}<p class="caption">Flip-check coverage is unavailable.</p>{% endif %}
{% if check.counts.omitted %}<p class="caption">{{ check.counts.omitted }} {{ 'supported' if check.has_flip else 'eligible' }} {{ 'region is' if check.counts.omitted == 1 else 'regions are' }} not shown because of display limits or evidence requirements. These cards are not an exhaustive map of possible edits.</p>{% endif %}
{% else %}<p class="caption">Region coverage counts are unavailable. Missing counts do not establish that no regions were measured.</p>{% endif %}
{% if check.map_grid %}<p class="caption">Measured grid {{ check.map_grid | join(' × ') }}. Displaying a larger image does not add detection detail.</p>{% endif %}
{% if check.excluded_percent is not none %}<p class="caption">{{ check.excluded_percent }}% of the measured grid was excluded as less reliable. Those areas were not cleared.</p>{% endif %}
{% if check.quality_reasons %}
<p class="caption">Image quality conditions by share of original pixels. The areas can overlap.</p>
<dl class="evidence-measurements">
{% for reason in check.quality_reasons %}<div><dt>{{ reason.label }}</dt><dd>{{ reason.percent }}%</dd></div>{% endfor %}
</dl>
{% endif %}
{% if check.get('coverage_map') %}
<figure class="inspection-coverage-map">
<img src="{{ check.coverage_map }}" alt="{{ check.label }} reliability mask on the measured image grid">
<figcaption class="caption">White marks cells that passed this check’s reliability filter. Black marks cells excluded from region selection.</figcaption>
</figure>
{% endif %}
</article>
{% endfor %}
<p class="caption">This coverage lists checks with recorded maps. Skipped, failed or unavailable checks remain in the analysis check record; their absence here is not a negative finding.</p>
</div>
{% endif %}
{% for packet in v.image_evidence.packets %}
<article class="image-evidence-packet" id="image-evidence-{{ packet.id }}">
<h3>{{ packet.id }} · {{ packet.title }}</h3>
{% if packet.get('customer_inference') %}<p class="finding-inference"><strong>Inference:</strong> {{ packet.customer_inference }}</p>{% endif %}
<p class="caption">{% if packet.evidence_type == 'localisation' %}Localisation candidate{% else %}Inspection region{% endif %}{% if packet.finding_ids %} · Findings {{ packet.finding_ids | join(', ') }}{% endif %}{% if packet.signal_refs %} · Checks {% for ref in packet.signal_refs %}{{ ref.display_id }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
{% if not v.image_evidence.withheld %}
<div class="evidence-plates{% if packet.artifacts.get('copy_donor') %} evidence-plates-copy{% elif packet.images | length > 3 %} evidence-plates-four{% endif %}">
{% for image in packet.images %}
<figure>
<img src="{{ image.uri }}" alt="{{ packet.id }}: {{ image.label }}">
<figcaption>{{ image.label }}</figcaption>
</figure>
{% endfor %}
</div>
{% if packet.get('overlay_legend') %}<p class="caption">{{ packet.overlay_legend }}</p>{% endif %}
{% endif %}
<p class="evidence-position caption">Region: x {{ packet.region.x }}, y {{ packet.region.y }}, width {{ packet.region.w }}, height {{ packet.region.h }} px. Crop: x {{ packet.crop_region.x }}, y {{ packet.crop_region.y }}, width {{ packet.crop_region.w }}, height {{ packet.crop_region.h }} px.</p>
<p><strong>Observed:</strong> {{ packet.observation }}</p>
<p><strong>Interpretation:</strong> {{ packet.interpretation }}</p>
{% if packet.get('localisation') %}<p class="caption">Measured grid {{ packet.localisation.grid | join(' × ') }} · selected area {{ '%.2f' | format(packet.localisation.region_area_fraction * 100) }}% · operating threshold {{ packet.localisation.threshold }} (uncalibrated). White mask cells mark this selected region; black does not mean verified authentic.</p>{% endif %}
{% if packet.get('eligibility_view') %}
<div class="image-eligibility-note"><p class="caption"><strong>{{ packet.eligibility_view.title }}.</strong>{% if packet.eligibility_view.score is not none %}{% if packet.eligibility_view.get('score_kind') == 'area_cells' %} Active screening cells <span class="mono">{{ packet.eligibility_view.score }}</span> · minimum <span class="mono">{{ packet.eligibility_view.threshold }}</span>.{% else %} Whole-image response <span class="mono">{{ packet.eligibility_view.score }}</span> · display threshold <span class="mono">{{ packet.eligibility_view.threshold }}</span>. This response is uncalibrated; it is not a region or pixel probability.{% endif %}{% endif %} {{ packet.eligibility_view.explanation }}</p></div>
{% endif %}
{% if packet.measurements %}<dl class="evidence-measurements">
{% for measure in packet.measurements %}<div><dt>{{ measure.label }}</dt><dd>{{ measure.value }}{% if measure.unit %} {{ measure.unit }}{% endif %}</dd></div>{% endfor %}
</dl>{% endif %}
{% if packet.limitations %}<p class="evidence-limits"><strong>Limits:</strong> {{ packet.limitations | join(' ') }}</p>{% endif %}
<p class="caption evidence-asset-hashes">{% for image in packet.images %}{{ image.label }} SHA-256 <span class="mono">{{ image.sha256 }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
</article>
{% else %}
<p>{% if v.image_evidence.get('inspection_checks') %}No local editing candidates are shown. The coverage above explains what was measured and withheld.{% elif (translation and translation.pairs) or (exact_pair and exact_pair.pair) %}No other local editing regions were recorded.{% else %}No separate local editing regions were recorded.{% endif %} An overall classification does not identify altered pixels. This does not establish that the image is unaltered.</p>
{% endfor %}
{% if v.image_evidence.omitted_regions %}<p class="caption">{{ v.image_evidence.omitted_regions }} additional candidate regions were omitted from this bounded evidence set.</p>{% endif %}
{% for note in v.image_evidence.limitations %}<p class="caption">{{ note }}</p>{% endfor %}
{% endif %}
</section>
{% endif %}
